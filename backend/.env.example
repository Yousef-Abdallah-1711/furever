# Custom SMTP configuration (provider not selected yet)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=

# Supabase values for local backend scripts
SUPABASE_URL=
SUPABASE_ANON_KEY=
# PLACEHOLDER ONLY: never put a real service-role key here or expose it to mobile/web.
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_ONLY_NEVER_USE_A_REAL_VALUE_HERE

# OAuth providers for local Supabase only; placeholders are not working credentials.
# Google order: web client ID first, then Android, then iOS (comma-separated as available).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=PLACEHOLDER_ONLY_WEB_ANDROID_IOS_CLIENT_IDS
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=PLACEHOLDER_ONLY_GOOGLE_CLIENT_SECRET
# Apple order: Services ID first, then native App IDs as needed (comma-separated).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=PLACEHOLDER_ONLY_SERVICES_ID_THEN_NATIVE_APP_IDS
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=PLACEHOLDER_ONLY_APPLE_CLIENT_SECRET
