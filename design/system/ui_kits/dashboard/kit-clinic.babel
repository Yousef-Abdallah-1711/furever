(()=>{
const DS=window.FurEverDesignSystem_f25da7;const {Button,Icon,Avatar,Banner,Input,StatusBadge,Chip,Skeleton}=DS;
const {useD,Shell,Table,Modal,Restricted,Stat}=window;
function Queue(){const {t,role}=useD();
  const init=[{id:'A-14',pet:t('Milo','ميلو'),ow:t('Sarah A.','سارة أ.'),d:0,s:'w'},{id:'A-15',pet:t('Luna','لونا'),ow:t('Hana M.','هنا م.'),d:0,s:'w'},{id:'A-11',pet:t('Max','ماكس'),ow:t('Youssef H.','يوسف ح.'),d:0,s:'p'},{id:'B-07',pet:t('Coco','كوكو'),ow:t('Nour S.','نور س.'),d:1,s:'c'},{id:'B-08',pet:t('Rex','ريكس'),ow:t('Ali K.','علي ك.'),d:1,s:'w'}];
  const [q,setQ]=React.useState(init);const [ci,setCi]=React.useState(false);
  const mv=(id,s)=>setQ(q.map(x=>x.id===id?{...x,s}:x));const rm=id=>setQ(q.filter(x=>x.id!==id));
  const docs=[t('Dr. Mona Adel','د. منى عادل'),t('Dr. Omar Samy','د. عمر سامي')];const lanes=[['w',t('Waiting','منتظر'),'warning'],['c',t('Called','متندى'),'info'],['p',t('In progress','جاري'),'primary']];
  const rec=role==='receptionist',vet=role==='vet';
  return <Shell {...window.__shell} title={t('Live queue','الطابور المباشر')} actions={<><span className="t-cap" style={{display:'flex',gap:6,alignItems:'center'}}><i style={{width:8,height:8,borderRadius:4,background:'var(--success)'}}/>{t('Live','مباشر')}</span><Button icon="scan-line" onClick={()=>setCi(true)}>{t('Check in','تسجيل وصول')}</Button></>}>
    <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:18}}>{docs.map((d,di)=><div key={d} className="fe-card" style={{display:'flex',flexDirection:'column',gap:12}}><div style={{display:'flex',gap:10,alignItems:'center'}}><Avatar name={d} size={32}/><b>{d}</b></div>
      <div style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:10}}>{lanes.map(([k,l,tn])=><div key={k} style={{background:'var(--surface-secondary)',borderRadius:12,padding:10,minHeight:150,display:'flex',flexDirection:'column',gap:8}}><div className="t-cap" style={{fontWeight:600}}>{l} · {q.filter(x=>x.d===di&&x.s===k).length}</div>
        {q.filter(x=>x.d===di&&x.s===k).map(x=><div key={x.id} className="fe-card" style={{padding:10,borderRadius:10,display:'flex',flexDirection:'column',gap:6}}><div style={{display:'flex',justifyContent:'space-between'}}><b dir="ltr">{x.id}</b></div><div style={{fontSize:'var(--fs-caption)'}}>{x.pet} · {x.ow}</div>
          <div style={{display:'flex',gap:4,flexWrap:'wrap'}}>{k==='w'&&<><Button size="s" onClick={()=>mv(x.id,'c')}>{t('Call','نادي')}</Button><Button size="s" variant="ghost" onClick={()=>rm(x.id)}>{t('No-show','لم يحضر')}</Button></>}{k==='c'&&<><Button size="s" disabled={rec} onClick={()=>mv(x.id,'p')}>{t('Start','ابدأ')}</Button><Button size="s" variant="ghost" onClick={()=>mv(x.id,'w')}>{t('Skip','تخطي')}</Button></>}{k==='p'&&<Button size="s" disabled={rec} variant="secondary" onClick={()=>rm(x.id)}>{t('Complete','إنهاء')}</Button>}</div></div>)}</div>)}</div></div>)}</div>
    {rec&&<div className="t-cap">{t('Receptionists can check in and call; only vets and managers start or complete visits.','الاستقبال يقدر يسجّل وصول وينادي؛ الدكتور والمدير بس يبدأ وينهي الكشف.')}</div>}
    {ci&&<Modal title={t('Check in a patient','تسجيل وصول مريض')} onClose={()=>setCi(false)}><div className="fe-ph" style={{height:160,borderRadius:12}}>{t('QR scanner','ماسح QR')}</div><Input label={t('Or type the booking code','أو اكتب كود الحجز')} ltr placeholder="FE-4821"/><div style={{display:'flex',gap:8,justifyContent:'flex-end'}}><Button variant="secondary" size="m" onClick={()=>setCi(false)}>{t('Cancel','إلغاء')}</Button><Button size="m" onClick={()=>{setQ([...q,{id:'A-16',pet:t('Bella','بيلا'),ow:t('Mai R.','مي ر.'),d:0,s:'w'}]);setCi(false)}}>{t('Check in','تسجيل')}</Button></div></Modal>}
  </Shell>}
function Today(){const {t,go}=useD();
  const P=[['10:30',t('Milo','ميلو'),t('Sarah Ahmed','سارة أحمد'),t('Check-up','كشف'),'confirmed',t('Confirmed','مؤكد')],['11:00',t('Luna','لونا'),t('Hana Magdy','هنا مجدي'),t('Vaccination','تطعيم'),'checked_in',t('Checked in','وصل')],['11:30',t('Coco','كوكو'),t('Nour Samir','نور سمير'),t('Dental','أسنان'),'pending',t('Pending','قيد الانتظار')]];
  return <Shell {...window.__shell} title={t('Today','النهارده')} actions={<Button icon="list-ordered" onClick={()=>window.__shell.setPage('queue')}>{t('Open queue','افتح الطابور')}</Button>}>
    <div style={{display:'flex',gap:14,flexWrap:'wrap'}}><Stat l={t('Booked','محجوز')} v="18"/><Stat l={t('Checked in','وصلوا')} v="5" tone="primary"/><Stat l={t('Waiting','منتظرين')} v="3" tone="warning"/><Stat l={t('Done','تم')} v="7" tone="success"/><Stat l={t('No-show','لم يحضروا')} v="1" tone="danger"/></div>
    <div className="t-h2">{t('Next patients','المرضى الجايين')}</div><Table cols={[t('Time','الوقت'),t('Pet','الحيوان'),t('Owner','المالك'),t('Service','الخدمة'),t('Status','الحالة')]} rows={P.map(([a,b,c,d,s,l])=>[<span dir="ltr">{a}</span>,b,c,d,<StatusBadge status={s}>{l}</StatusBadge>])}/></Shell>}
function Appointments(){const {t}=useD();const [dr,setDr]=React.useState(null);
  const A=[['10:30',t('Milo','ميلو'),t('Sarah Ahmed','سارة أحمد'),t('Dr. Mona Adel','د. منى عادل'),'confirmed',t('Confirmed','مؤكد')],['11:00',t('Luna','لونا'),t('Hana Magdy','هنا مجدي'),t('Dr. Omar Samy','د. عمر سامي'),'checked_in',t('Checked in','وصل')],['12:00',t('Rex','ريكس'),t('Ali Khaled','علي خالد'),t('Dr. Mona Adel','د. منى عادل'),'cancelled',t('Cancelled','ملغي')]];
  return <Shell {...window.__shell} title={t('Appointments','المواعيد')} actions={<><Chip on>{t('List','قائمة')}</Chip><Chip>{t('Day','يوم')}</Chip><Chip>{t('Week','أسبوع')}</Chip></>}>
    <Table cols={[t('Time','الوقت'),t('Pet','الحيوان'),t('Owner','المالك'),t('Doctor','الدكتور'),t('Status','الحالة'),'']} rows={A.map(([a,b,c,d,s,l])=>[<span dir="ltr">{a}</span>,b,c,d,<StatusBadge status={s}>{l}</StatusBadge>,<Button size="s" variant="ghost" onClick={()=>setDr(b)}>{t('Details','تفاصيل')}</Button>])}/>
    {dr&&<Modal title={dr} onClose={()=>setDr(null)}><div className="t-cap">{t('Owner, notes and history appear here.','بيانات المالك والملاحظات والسجل هنا.')}</div><div style={{display:'flex',gap:8,flexWrap:'wrap'}}><Button size="m">{t('Confirm','تأكيد')}</Button><Button size="m" variant="secondary">{t('Reschedule','تغيير الميعاد')}</Button><Button size="m" variant="destructive" onClick={()=>setDr(null)}>{t('Cancel with reason','إلغاء بسبب')}</Button></div></Modal>}</Shell>}
function Services(){const {t,role}=useD();const ro=role!=='manager';
  const S=[[t('General check-up','كشف عام'),'30',250,true],[t('Vaccination','تطعيم'),'20',300,true],[t('Dental cleaning','تنضيف أسنان'),'45',600,false]];
  return <Shell {...window.__shell} title={t('Services','الخدمات')} actions={<Button icon="plus" disabled={ro}>{t('Add service','إضافة خدمة')}</Button>}>
    {ro&&<Banner tone="info">{t('Only managers can edit services. You can view them.','المدير بس اللي يعدّل الخدمات. تقدر تشوفها.')}</Banner>}
    <Table cols={[t('Name','الاسم'),t('Duration','المدة'),t('Price (EGP)','السعر (جنيه)'),t('Active','فعّال')]} rows={S.map(([n,m,p,a])=>[n,<span dir="ltr">{m} min</span>,<span dir="ltr">{p}</span>,<input type="checkbox" defaultChecked={a} disabled={ro} style={{width:20,height:20,accentColor:'var(--primary)'}}/>])}/></Shell>}
function Staff(){const {t,role}=useD();
  return <Shell {...window.__shell} title={t('Staff','الموظفين')} actions={role==='manager'&&<Button icon="user-plus">{t('Invite','دعوة')}</Button>}>{role!=='manager'?<Restricted need={t('manager','مدير')}/>:<Table cols={[t('Name','الاسم'),t('Email','الإيميل'),t('Level','المستوى'),t('Status','الحالة')]} rows={[[t('Dr. Mona Adel','د. منى عادل'),'mona@paws.eg',t('Manager','مدير'),<StatusBadge status="completed">{t('Active','نشط')}</StatusBadge>],[t('Rana Fathy','رنا فتحي'),'rana@paws.eg',t('Receptionist','استقبال'),<StatusBadge status="pending">{t('Invited','تمت الدعوة')}</StatusBadge>]]}/>}</Shell>}
function Profile(){const {t}=useD();
  return <Shell {...window.__shell} title={t('Clinic profile','ملف العيادة')}><Banner tone="warning">{t('Your clinic is pending approval. It is not visible to owners yet.','عيادتك لسه تحت المراجعة. مش ظاهرة للمالكين.')}</Banner><div className="fe-card" style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:16}}><Input label={t('Name (English)','الاسم (إنجليزي)')} defaultValue="Paws Vet Clinic"/><Input label={t('Name (Arabic)','الاسم (عربي)')} defaultValue="عيادة باوز البيطرية"/><Input label={t('Phone','التليفون')} ltr defaultValue="+20 2 2345 6789"/><Input label="WhatsApp" ltr defaultValue="+20 100 123 4567"/></div></Shell>}
Object.assign(window,{ClinicQueue:Queue,ClinicToday:Today,ClinicAppts:Appointments,ClinicServices:Services,ClinicStaff:Staff,ClinicProfile:Profile});
})();