(()=>{
const DS=window.FurEverDesignSystem_f25da7;const {Button,Icon,Banner,Input,StatusBadge,Chip,EmptyState,PhaseTag}=DS;
const {useD,Shell,Table,Modal,Restricted,Stat}=window;
const Bars=({v,h=120,c='var(--primary)'})=><div dir="ltr" style={{display:'flex',alignItems:'flex-end',gap:6,height:h}}>{v.map((x,i)=><div key={i} style={{flex:1,height:x+'%',background:c,borderRadius:'4px 4px 0 0',opacity:.55+.45*(i/v.length)}}/>)}</div>;
function Overview(){const {t}=useD();
  return <Shell {...window.__shell} title={t('Overview','نظرة عامة')} actions={<Chip on icon="calendar">{t('Last 7 days','آخر 7 أيام')}</Chip>}>
    <div style={{display:'flex',gap:14,flexWrap:'wrap'}}><Stat l={t('Total users','إجمالي المستخدمين')} v="48,210" s="+1,240"/><Stat l={t('Pets','الحيوانات')} v="62,880"/><Stat l={t('Bookings today','حجوزات النهارده')} v="412"/><Stat l={t('No-show rate','نسبة عدم الحضور')} v="9.4%" tone="warning"/><Stat l={t('Pending clinics','عيادات منتظرة')} v="6" tone="info"/></div>
    <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:14}}><div className="fe-card"><div className="t-h3" style={{marginBottom:12}}>{t('Sign-ups per day','التسجيلات يوميًا')}</div><Bars v={[40,55,48,70,62,85,78]}/></div><div className="fe-card"><div className="t-h3" style={{marginBottom:12}}>{t('Bookings per day','الحجوزات يوميًا')}</div><Bars v={[50,45,60,58,72,66,90]} c="var(--info)"/></div></div>
    <div className="t-cap">{t('Data refreshed hourly from SQL views.','البيانات بتتحدّث كل ساعة.')}</div></Shell>}
function Clinics(){const {t}=useD();const [m,setM]=React.useState(null);const [why,setWhy]=React.useState('');const [f,setF]=React.useState('all');
  const [C,setC]=React.useState([[t('Paws Vet Clinic','عيادة باوز'),t('Cairo','القاهرة'),'active'],[t('Happy Tails','هابي تيلز'),t('Giza','الجيزة'),'pending'],[t('Vet Rescue Maadi','فيت ريسكيو المعادي'),t('Cairo','القاهرة'),'suspended']]);
  const L={active:[t('Active','نشطة'),'completed'],pending:[t('Pending','منتظرة'),'pending'],suspended:[t('Suspended','موقوفة'),'no_show']};
  const act=(n,s)=>setC(C.map(c=>c[0]===n?[c[0],c[1],s]:c));
  return <Shell {...window.__shell} title={t('Clinics','العيادات')} actions={<Button icon="plus">{t('New clinic','عيادة جديدة')}</Button>}>
    <div style={{display:'flex',gap:8}}>{[['all',t('All','الكل')],['pending',t('Pending','منتظرة')],['active',t('Active','نشطة')],['suspended',t('Suspended','موقوفة')]].map(([k,l])=><Chip key={k} on={f===k} onClick={()=>setF(k)}>{l}</Chip>)}</div>
    <Table empty={t('No clinics in this status','مفيش عيادات بالحالة دي')} cols={[t('Clinic','العيادة'),t('City','المدينة'),t('Status','الحالة'),'']} rows={C.filter(c=>f==='all'||c[2]===f).map(([n,ci,s])=>[n,ci,<StatusBadge status={L[s][1]}>{L[s][0]}</StatusBadge>,<div style={{display:'flex',gap:6}}>{s==='pending'&&<Button size="s" onClick={()=>act(n,'active')}>{t('Approve','موافقة')}</Button>}{s==='active'&&<Button size="s" variant="destructive" onClick={()=>setM(n)}>{t('Suspend','إيقاف')}</Button>}{s==='suspended'&&<Button size="s" variant="secondary" onClick={()=>act(n,'active')}>{t('Restore','استعادة')}</Button>}</div>])}/>
    {m&&<Modal title={t('Suspend ','إيقاف ')+m+'?'} onClose={()=>setM(null)}><div style={{color:'var(--text-secondary)'}}>{t('The clinic disappears from the owner app. The reason is written to the audit log.','العيادة هتختفي من تطبيق المالكين. السبب هيتسجّل في سجل المراجعة.')}</div><Input label={t('Reason (required)','السبب (مطلوب)')} value={why} onChange={e=>setWhy(e.target.value)}/><div style={{display:'flex',gap:8,justifyContent:'flex-end'}}><Button variant="secondary" size="m" onClick={()=>setM(null)}>{t('Cancel','إلغاء')}</Button><Button variant="destructive" size="m" disabled={!why.trim()} onClick={()=>{act(m,'suspended');setM(null);setWhy('')}}>{t('Suspend clinic','إيقاف العيادة')}</Button></div></Modal>}</Shell>}
function Users(){const {t}=useD();
  return <Shell {...window.__shell} title={t('Users','المستخدمين')} actions={<Button variant="secondary" icon="download">CSV</Button>}><Table cols={[t('Name','الاسم'),t('Phone','الموبايل'),t('Role','الدور'),t('Status','الحالة'),t('City','المدينة'),'']} rows={[[t('Sarah Ahmed','سارة أحمد'),<span dir="ltr">+20 100 123 4567</span>,'owner',<StatusBadge status="completed">{t('Active','نشط')}</StatusBadge>,t('Cairo','القاهرة'),<Button size="s" variant="ghost">{t('Suspend','إيقاف')}</Button>],[t('Youssef Hassan','يوسف حسن'),<span dir="ltr">+20 111 555 0102</span>,'owner',<StatusBadge status="completed">{t('Active','نشط')}</StatusBadge>,t('Giza','الجيزة'),<Button size="s" variant="ghost">{t('Suspend','إيقاف')}</Button>],[t('Omar Z.','عمر ز.'),<span dir="ltr">+20 122 555 0199</span>,'owner',<StatusBadge status="no_show">{t('Suspended','موقوف')}</StatusBadge>,t('Alexandria','الإسكندرية'),<Button size="s" variant="secondary">{t('Restore','استعادة')}</Button>]]}/></Shell>}
function RefData(){const {t}=useD();const [tab,setTab]=React.useState(1);
  return <Shell {...window.__shell} title={t('Reference data','البيانات المرجعية')}><div style={{display:'flex',gap:8}}>{[t('Cities','المدن'),t('Breeds','السلالات'),t('Vaccine types','أنواع التطعيم'),t('Specialties','التخصصات')].map((x,i)=><Chip key={i} on={tab===i} onClick={()=>setTab(i)}>{x}</Chip>)}</div>
    <Table cols={['English','العربية',t('Species','النوع'),t('Active','فعّال')]} rows={[['Persian','شيرازي',t('Cat','قطة'),true],['Golden Retriever','جولدن ريتريفر',t('Dog','كلب'),true],['Siamese','سيامي',t('Cat','قطة'),false]].map(([a,b,c,d])=>[<input className="fe-input" defaultValue={a} dir="ltr" style={{height:36}}/>,<input className="fe-input" defaultValue={b} dir="rtl" style={{height:36,fontFamily:'var(--font-ar)'}}/>,c,<input type="checkbox" defaultChecked={d} style={{width:20,height:20,accentColor:'var(--primary)'}}/>])}/><div className="t-cap">{t('Rows are deactivated, never deleted.','الصفوف بتتعطّل، مش بتتمسح.')}</div></Shell>}
function Flags(){const {t,role}=useD();
  return <Shell {...window.__shell} title={t('Flags and config','الفلاجز والإعدادات')}>{role!=='super_admin'?<Restricted need={t('super admin','سوبر أدمن')}/>:<><Banner tone="warning">{t('Changes apply to all users at next app launch.','التغييرات بتتطبّق على كل المستخدمين عند فتح التطبيق.')}</Banner><div className="fe-card" style={{padding:0}}>{[['payments_enabled',false],['video_enabled',false],['shop_enabled',false],['mating_enabled',false],['adoption_enabled',false],['maintenance_mode',false]].map(([k,v],i)=><label key={k} style={{display:'flex',justifyContent:'space-between',alignItems:'center',padding:'14px 16px',borderTop:i?'1px solid var(--border)':0}}><code dir="ltr">{k}</code><input type="checkbox" defaultChecked={v} style={{width:22,height:22,accentColor:'var(--primary)'}}/></label>)}</div></>}</Shell>}
function Broadcast(){const {t}=useD();
  return <Shell {...window.__shell} title={t('Broadcast','إشعار جماعي')}><div className="fe-card" style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:16}}><Input label="English" placeholder="Message in English"/><div dir="rtl"><Input label="العربية" placeholder="الرسالة بالعربي"/></div><Input label={t('Segment','الشريحة')} defaultValue={t('All users','كل المستخدمين')}/><Input label={t('Schedule','الجدولة')} defaultValue="20/10/2026 09:00" ltr/><div style={{gridColumn:'1/-1',display:'flex',gap:8,justifyContent:'flex-end'}}><Button variant="secondary">{t('Preview','معاينة')}</Button><Button icon="send">{t('Send','إرسال')}</Button></div></div></Shell>}
function Audit(){const {t}=useD();
  return <Shell {...window.__shell} title={t('Audit log','سجل المراجعة')}><Table cols={[t('When','الوقت'),t('Actor','المنفّذ'),t('Action','الإجراء'),t('Entity','العنصر')]} rows={[['18/10 09:12','admin@furever.app','clinic.suspend','Vet Rescue Maadi'],['18/10 08:40','admin@furever.app','pet.read','Milo'],['17/10 17:05','super@furever.app','flag.update','shop_enabled']].map(r=>r.map((c,i)=><span dir="ltr">{c}</span>))}/></Shell>}
function LaterPage({name,phase}){const {t}=useD();
  return <Shell {...window.__shell} title={name} actions={<PhaseTag phase={phase}>{t('Later phase · ','مرحلة لاحقة · ')+phase}</PhaseTag>}><div className="fe-card"><EmptyState icon="lock" title={t('Not part of the MVP','مش في النسخة الأولى')} body={t('This screen ships in a later phase and stays hidden until its flag is on.','الشاشة دي بتتضاف في مرحلة لاحقة وبتفضل مخفية لحد ما الفلاج يتفعّل.')}/></div></Shell>}
Object.assign(window,{AdminOverview:Overview,AdminClinics:Clinics,AdminUsers:Users,AdminRef:RefData,AdminFlags:Flags,AdminBroadcast:Broadcast,AdminAudit:Audit,LaterPage});
})();