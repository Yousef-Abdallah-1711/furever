(()=>{
const DS=window.FurEverDesignSystem_f25da7;const {Button,Icon,Banner,Chip,Card,Input,StatusBadge}=DS;
const {useE,ESCREEN:Screen,EHeader:Header,ESteps:Steps,ESheet:Sheet,EPick:Pick,eFmt:fmt,eAddM:addM,eVaxStatus:vaxStatus,eltr:ltr}=window;
const VAX={cat:[['Rabies','السعار',12],['FVRCP','الثلاثي',12],['Deworming','الديدان',3]],dog:[['Rabies','السعار',12],['DHPP','الخماسي',12],['Bordetella','بورديتيلا',6]],other:[['Rabies','السعار',12]]};
const sLabel=(t,s)=>s==='overdue'?t('Overdue','متأخر'):s==='due_soon'?t('Due soon','قرّب ميعاده'):t('Up to date','متحصّن');
function PetHealth(){const {t,go,st,set,next,toast,ret}=useE();const p=st.pet;const [sh,setSh]=React.useState(false);
  const attach=()=>{set({health:{...st.health,card:'vaccination-card.jpg'}});setSh(false);toast(t('File attached','تم إرفاق الملف'),true)};
  return <Screen header={<Header back="petPhoto" title={t(p.name+'\'s health passport',(p.name||'')+': جواز الصحة')} sub={t('Step 4 of 4 · Optional','الخطوة 4 من 4 · اختياري')}/>}><Steps n={2}/><div style={{padding:'8px 24px 24px',display:'flex',flexDirection:'column',gap:12}}>
    <div style={{color:'var(--text-secondary)'}}>{t('Add vaccination info now, or skip and do it later from the pet profile.','ضيف معلومات التطعيم دلوقتي، أو تخطّى وكمّلها بعدين من ملف الحيوان.')}</div>
    <Card pad={14} onClick={()=>setSh(true)} style={{display:'flex',gap:12,alignItems:'center'}}><Icon name="scan-line" style={{color:'var(--primary)'}}/><div style={{flex:1}}><b>{t('Upload vaccination card','ارفع كارت التطعيم')}</b><div className="t-cap">{st.health.card?t('Attached: ','مرفق: ')+st.health.card:t('Photo or PDF','صورة أو PDF')}</div></div>{st.health.card?<Icon name="circle-check" style={{color:'var(--success)'}}/>:<Icon name="chevron-right" flip size={18}/>}</Card>
    <Card pad={14} onClick={()=>go('vaxForm')} style={{display:'flex',gap:12,alignItems:'center'}}><Icon name="pencil" style={{color:'var(--primary)'}}/><div style={{flex:1}}><b>{t('Enter manually','أدخل يدوي')}</b><div className="t-cap">{st.health.vax?st.health.vax.type+' · '+t('next due ','الجاي ')+fmt(st.health.vax.next):t('Vaccine, date, next due','التطعيم والتاريخ والموعد الجاي')}</div></div>{st.health.vax?<Icon name="circle-check" style={{color:'var(--success)'}}/>:<Icon name="chevron-right" flip size={18}/>}</Card>
    <Button block onClick={()=>next('perms')}>{st.health.card||st.health.vax?t('Continue','متابعة'):t('Skip for now','تخطي دلوقتي')}</Button>
    {!st.health.card&&!st.health.vax&&<div className="fe-hint" style={{textAlign:'center'}}>{t('You can add this any time from the pet profile.','تقدر تضيفه في أي وقت من ملف الحيوان.')}</div>}</div>
    {sh&&<Sheet sim title={t('Choose a file','اختار ملف')} onClose={()=>setSh(false)}><Pick onPick={attach} items={[['a','vaccination-card.jpg'],['b','vaccination-card.pdf']]}/><div className="t-cap" style={{marginTop:8}}>{t('Mock picker. No real files are accessed.','اختيار تجريبي. مفيش وصول حقيقي للملفات.')}</div></Sheet>}</Screen>}
function VaxForm(){const {t,go,st,set,next,lang,ret}=useE();const p=st.pet;const list=VAX[p.species]||VAX.other;
  const [ty,setTy]=React.useState(st.health.vax?.type||'');const [given,setGiven]=React.useState(st.health.vax?.given||'');const [nx,setNx]=React.useState(st.health.vax?.next||'');const [batch,setBatch]=React.useState('');const [er,setEr]=React.useState({});const [sh,setSh]=React.useState(false);
  const months=ty?(list.find(v=>v[0]===ty)||[0,0,12])[2]:12;
  const onGiven=v=>{setGiven(v);setEr({...er,given:null});if(v&&ty)setNx(addM(v,months))};
  const onType=k=>{setTy(k);setSh(false);setEr({...er,ty:null});if(given){const m=(list.find(v=>v[0]===k)||[0,0,12])[2];setNx(addM(given,m))}};
  const save=()=>{const e={};if(!ty)e.ty=t('Choose a vaccine','اختار التطعيم');if(!given)e.given=t('Enter the date given','اكتب تاريخ التطعيم');else if(new Date(given)>window.ETODAY)e.given=t('Date cannot be in the future','التاريخ مينفعش يكون في المستقبل');if(!nx)e.nx=t('Enter the next due date','اكتب الموعد الجاي');else if(given&&new Date(nx)<=new Date(given))e.nx=t('Next due must be after the date given','الموعد الجاي لازم يكون بعد تاريخ التطعيم');setEr(e);if(Object.keys(e).length)return;set({health:{...st.health,vax:{type:ty,given,next:nx,batch}}});next(ret?ret:'petHealth')};
  return <Screen header={<Header back={ret||'petHealth'} title={t('Add vaccination','إضافة تطعيم')}/>}><div style={{padding:'8px 24px 24px',display:'flex',flexDirection:'column',gap:14}}>
    <div className="fe-field"><span className="fe-label">{t('Vaccine type','نوع التطعيم')}</span><button onClick={()=>setSh(true)} className={'fe-input'+(er.ty?' error':'')} style={{display:'flex',alignItems:'center',gap:8,textAlign:'start',cursor:'pointer',fontFamily:'inherit',color:ty?'var(--text-primary)':'var(--text-secondary)'}}><Icon name="syringe" size={18}/><span style={{flex:1}}>{ty?(lang==='ar'?list.find(v=>v[0]===ty)[1]:ty):t('Select vaccine','اختار التطعيم')}</span><Icon name="chevron-down" size={18}/></button>{er.ty&&<span className="fe-hint error">{er.ty}</span>}</div>
    <div className="fe-field"><span className="fe-label">{t('Date given','تاريخ التطعيم')}</span><input type="date" className={'fe-input'+(er.given?' error':'')} dir="ltr" style={{textAlign:'start'}} value={given} onChange={e=>onGiven(e.target.value)}/>{er.given&&<span className="fe-hint error">{er.given}</span>}</div>
    <div className="fe-field"><span className="fe-label">{t('Next due','الموعد الجاي')}</span><input type="date" className={'fe-input'+(er.nx?' error':'')} dir="ltr" style={{textAlign:'start'}} value={nx} onChange={e=>{setNx(e.target.value);setEr({...er,nx:null})}}/><span className={'fe-hint'+(er.nx?' error':'')}>{er.nx||t('Filled from the vaccine interval. You can edit it.','اتملّى من فترة التطعيم. تقدر تعدّله.')}</span></div>
    <Input label={t('Batch number (optional)','رقم التشغيلة (اختياري)')} ltr value={batch} onChange={e=>setBatch(e.target.value)}/>
    <Button block onClick={save}>{t('Save','حفظ')}</Button></div>
    {sh&&<Sheet title={t('Vaccine type','نوع التطعيم')} onClose={()=>setSh(false)}><Pick sel={ty} onPick={onType} items={list.map(v=>[v[0],lang==='ar'?v[1]:v[0]])}/></Sheet>}</Screen>}
function Perms(){const {t,go,st,set,next,openSheet,closeSheet}=useE();
  const OS=()=><Sheet sim title={t('Allow FurEver to send you notifications?','تسمح لفيرايفر يبعتلك إشعارات؟')} onClose={closeSheet}><div className="t-cap" style={{marginBottom:12}}>{t('Prototype system prompt. No real permission is requested.','رسالة نظام تجريبية. مفيش طلب صلاحية حقيقي.')}</div><div style={{display:'flex',flexDirection:'column',gap:8}}><Button block onClick={()=>{set({perm:'allowed'});closeSheet();next('summary')}}>{t('Allow','سماح')}</Button><Button block variant="secondary" onClick={()=>{set({perm:'denied'});closeSheet();next('summary')}}>{t("Don't allow",'عدم السماح')}</Button></div></Sheet>;
  return <Screen header={<Header back="petHealth"/>}><Steps n={3}/><div style={{padding:'16px 24px 24px',display:'flex',flexDirection:'column',gap:16,alignItems:'center',textAlign:'center'}}><div className="fe-ph" style={{width:150,height:150,borderRadius:'50%',color:'var(--primary)'}}><Icon name="bell-ring" size={54}/></div><div className="t-h1">{t('Stay on top of care','خليك مطمّن على حيوانك')}</div>
    <div style={{width:'100%',display:'flex',flexDirection:'column',gap:10,textAlign:'start'}}>{[['syringe',t('Vaccination reminders','تذكير بالتطعيمات'),t('7 days, 1 day and on the due date.','قبلها بـ 7 أيام ويوم وفي يوم الموعد.')],['map-pin',t('Nearby clinics','عيادات قريبة'),t('Location finds clinics near you.','الموقع بيلاقيلك عيادات قريبة.')]].map(([i,a,b])=><Card key={a} pad={12} style={{display:'flex',gap:12,alignItems:'center'}}><Icon name={i} style={{color:'var(--primary)'}}/><div><b>{a}</b><div className="t-cap">{b}</div></div></Card>)}</div>
    <div className="t-cap">{t('The app works without either.','التطبيق بيشتغل من غير الاتنين.')}</div>
    <Button block onClick={()=>openSheet(<OS/>)}>{t('Allow','سماح')}</Button><Button variant="ghost" block onClick={()=>{set({perm:'skipped'});next('summary')}}>{t('Not now','مش دلوقتي')}</Button></div></Screen>}
function Summary(){const {t,go,st,set,lang,editFromSummary}=useE();const p=st.pet;const u=st.user;
  const sp={cat:t('Cat','قطة'),dog:t('Dog','كلب'),bird:t('Bird','طائر'),rabbit:t('Rabbit','أرنب'),other:t('Pet','حيوان')}[p.species]||'';
  const vs=st.health.vax?vaxStatus(st.health.vax.next):null;
  const Row=({title,edit,children})=><Card pad={14} style={{display:'flex',gap:12}}><div style={{flex:1,display:'flex',flexDirection:'column',gap:4}}><div className="t-cap">{title}</div>{children}</div><Button variant="ghost" size="s" onClick={edit}>{t('Edit','تعديل')}</Button></Card>;
  return <Screen header={<Header back="perms" title={t('All set!','كله جاهز!')}/>}><div style={{padding:'0 24px 24px',display:'flex',flexDirection:'column',gap:12}}>
    <div style={{color:'var(--text-secondary)'}}>{t('Review your details before you continue.','راجع بياناتك قبل ما تكمّل.')}</div>
    <Row title={t('Profile','البيانات')} edit={()=>editFromSummary('profile')}><b>{u.name}</b><div className="t-cap">{(window.ECITIES.find(c=>c[0]===u.city)||[])[lang==='ar'?1:0]} · {ltr('+20 '+(st.phone||'100 123 4567'))}</div></Row>
    {p.name?<Row title={t('Pet','الحيوان')} edit={()=>editFromSummary('petBasics')}><div style={{display:'flex',gap:10,alignItems:'center'}}><div className="fe-ph" style={{width:48,height:48,borderRadius:24,background:p.photo||undefined}}/><div><b>{p.name}</b><div className="t-cap">{sp} · {p.breed} · {p.mode==='date'?fmt0(p.birth):p.years+t(' y ',' سنة ')+p.months+t(' m',' شهر')}</div></div></div></Row>:<Row title={t('Pet','الحيوان')} edit={()=>editFromSummary('petSpecies')}><span style={{color:'var(--text-secondary)'}}>{t('No pet added yet','لسه مفيش حيوان')}</span></Row>}
    {p.name&&<Row title={t('Health passport','جواز الصحة')} edit={()=>editFromSummary('petHealth')}>{st.health.vax||st.health.card?<div style={{display:'flex',gap:6,flexWrap:'wrap'}}>{vs&&<StatusBadge status={vs}>{sLabel(t,vs)}</StatusBadge>}{st.health.card&&<StatusBadge status="self_reported">{t('Card attached','كارت مرفق')}</StatusBadge>}</div>:<span style={{color:'var(--text-secondary)'}}>{t('Skipped. Add it later.','اتخطّى. ضيفه بعدين.')}</span>}</Row>}
    <Row title={t('Notifications','الإشعارات')} edit={()=>editFromSummary('perms')}><span>{st.perm==='allowed'?t('Allowed (simulated)','مسموح (محاكاة)'):st.perm==='denied'?t('Not allowed','مش مسموح'):t('Skipped','اتخطّى')}</span></Row>
    <Button block onClick={()=>go('home')}>{t('Go to Home','روح للرئيسية')}</Button></div></Screen>}
const fmt0=d=>d?fmt(d):'';
Object.assign(window,{EPetHealth:PetHealth,EVaxForm:VaxForm,EPerms:Perms,ESummary:Summary,eSLabel:sLabel});
})();