(()=>{
const DS=window.FurEverDesignSystem_f25da7;const {Button,Input,Chip,Banner,Card,Icon,IconButton,Avatar,StatusBadge,PetCard,Stepper,ConfirmSheet,Rating}=DS;
const {useL,Header,Screen,Photo,ListState,ltr}=window;
const pets=t=>[{n:t('Milo','ميلو'),b:t('Persian cat','قطة شيرازي'),a:t('2 years','سنتين'),s:'due_soon',sl:t('Due soon','قرّب ميعاده')},{n:t('Max','ماكس'),b:t('Golden Retriever','جولدن ريتريفر'),a:t('3 years','3 سنين'),s:'up_to_date',sl:t('Up to date','متحصّن')}];
function Home(){const {t,go,st}=useL();const P=pets(t);
  const cats=[['stethoscope',t('Vet Clinics','عيادات'),'clinics'],['paw-print',t('My Pets','حيواناتي'),'pets'],['siren',t('Emergency','طوارئ'),'emergency']];
  return <Screen tab="home">
    <div style={{background:'linear-gradient(var(--bg-gradient-top),var(--bg-gradient-bottom))',padding:'8px 16px 16px'}}>
      <div style={{display:'flex',alignItems:'center',gap:12,marginBottom:14}}><Avatar name="SA" size={44}/><div style={{flex:1}}><div className="t-cap">{t('Good morning','صباح الخير')}</div><div className="t-h3">{t('Sarah','سارة')}</div></div><IconButton icon="bell" label={t('Notifications','الإشعارات')} badge={2} onClick={()=>go('notifications')}/></div>
      <div className="fe-input" style={{display:'flex',alignItems:'center',gap:10,background:'var(--surface-secondary)',borderColor:'transparent',color:'var(--text-secondary)'}} onClick={()=>go('clinics')}><Icon name="search" size={20}/>{t('Search clinics, vets…','دوّر على عيادة أو دكتور…')}</div></div>
    <div style={{padding:'0 16px 16px',display:'flex',flexDirection:'column',gap:18}}>
      <div><div className="t-h2" style={{marginBottom:10}}>{t('Categories','الأقسام')}</div><div style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:10}}>{cats.map(([i,l,r])=><Card key={r} tint pad={14} onClick={()=>go(r)} style={{display:'flex',flexDirection:'column',alignItems:'center',gap:8,textAlign:'center'}}><Icon name={i} size={28} style={{color:r==='emergency'?'var(--danger)':'var(--primary)'}}/><span style={{fontWeight:500}}>{l}</span></Card>)}</div></div>
      {st==='loading'?<ListState rows={2} h={96}/>:<>
      <Card onClick={()=>go('booking')} style={{display:'flex',flexDirection:'column',gap:8}}><div style={{display:'flex',justifyContent:'space-between'}}><span className="t-cap">{t('Next appointment','الحجز الجاي')}</span><StatusBadge status="confirmed">{t('Confirmed','مؤكد')}</StatusBadge></div><div className="t-h3">{t('Paws Vet Clinic','عيادة باوز البيطرية')}</div><div style={{display:'flex',gap:8,color:'var(--text-secondary)'}}><Icon name="calendar" size={18}/>{t('Tue 20 Oct','الثلاثاء 20 أكتوبر')} · {ltr('10:30')}</div></Card>
      <Banner tone="warning" action={<Button size="s" variant="outline" onClick={()=>go('passport')}>{t('View','عرض')}</Button>}>{t('Milo has a vaccine due in 5 days.','ميلو عليه تطعيم بعد 5 أيام.')}</Banner></>}
      <div><div style={{display:'flex',justifyContent:'space-between',marginBottom:10}}><div className="t-h2">{t('My pets','حيواناتي')}</div><Button variant="ghost" size="s" onClick={()=>go('pets')}>{t('See all','عرض الكل')}</Button></div>
      <div style={{display:'flex',gap:12,overflow:'auto'}}>{P.map(p=><div key={p.n} onClick={()=>go('passport')} style={{textAlign:'center',cursor:'pointer'}}><Photo w={72} h={72} r={36}/><div style={{fontWeight:500,marginTop:4}}>{p.n}</div></div>)}<div onClick={()=>go('addpet')} style={{textAlign:'center',cursor:'pointer'}}><div style={{width:72,height:72,borderRadius:36,border:'1.5px dashed var(--primary)',color:'var(--primary)',display:'flex',alignItems:'center',justifyContent:'center'}}><Icon name="plus"/></div><div style={{marginTop:4}}>{t('Add','إضافة')}</div></div></div></div>
      <Button variant="destructive" block icon="siren" onClick={()=>go('emergency')}>{t('Emergency vets near me','أقرب طوارئ بيطرية')}</Button></div></Screen>}
function Pets(){const {t,go}=useL();const P=pets(t);
  return <Screen tab="pets" header={<Header title={t('My Pets','حيواناتي')} right={<Button size="s" icon="plus" onClick={()=>go('addpet')}>{t('Add pet','إضافة')}</Button>}/>}>
    <div style={{padding:16,display:'flex',flexDirection:'column',gap:12}}><ListState emptyIcon="paw-print" emptyTitle={t('No pets yet','لسه مفيش حيوانات')} emptyBody={t('Add your first pet to start a health passport.','ضيف أول حيوان عشان تبدأ جواز الصحة.')} emptyAction={t('Add pet','إضافة حيوان')} onAction={()=>go('addpet')}>
      {P.map(p=><PetCard key={p.n} name={p.n} breed={p.b} age={p.a} status={p.s} statusLabel={p.sl} onClick={()=>go('passport')}/>)}</ListState></div></Screen>}
function AddPet(){const {t,go}=useL();const [s,setS]=React.useState(0);const [sp,setSp]=React.useState('cat');
  const names=[t('Species','النوع'),t('Basics','الأساسيات'),t('Photo','الصورة'),t('Vaccination','التطعيم')];
  return <Screen header={<Header back="pets" title={t('Add pet','إضافة حيوان')}/>}>
    <div style={{padding:'0 20px',display:'flex',flexDirection:'column',gap:16,height:'100%'}}><div><div style={{height:6,borderRadius:3,background:'var(--border)'}}><div style={{height:6,borderRadius:3,background:'var(--primary)',width:(s+1)*25+'%',transition:'width .25s'}}/></div><div className="t-cap" style={{marginTop:6}}>{t('Step','الخطوة')} {s+1}/4 · {names[s]}</div></div>
    {s===0&&<div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:12}}>{[['cat','cat',t('Cat','قطة')],['dog','dog',t('Dog','كلب')],['bird','bird',t('Bird','طائر')],['rabbit','rabbit',t('Rabbit','أرنب')]].map(([k,i,l])=><Card key={k} tint={sp===k} onClick={()=>setSp(k)} pad={20} style={{display:'flex',flexDirection:'column',alignItems:'center',gap:8}}><Icon name={i} size={36} style={{color:'var(--primary)'}}/>{l}</Card>)}</div>}
    {s===1&&<><Input label={t('Name','الاسم')} defaultValue={t('Milo','ميلو')}/><Input label={t('Breed','السلالة')} icon="search" defaultValue={t('Persian','شيرازي')}/><div style={{display:'flex',gap:8}}><Chip on>{t('Male','ذكر')}</Chip><Chip>{t('Female','أنثى')}</Chip></div><Input label={t('Birth date','تاريخ الميلاد')} icon="calendar" defaultValue="12/03/2024" ltr/><Input label={t('Weight (kg)','الوزن (كجم)')} defaultValue="4.2" ltr/></>}
    {s===2&&<div style={{textAlign:'center',display:'flex',flexDirection:'column',alignItems:'center',gap:12}}><Photo w={180} h={180} r={90} label={t('add photo','أضف صورة')}/><Button variant="secondary" icon="camera" size="m">{t('Camera','الكاميرا')}</Button><Button variant="ghost" size="m" icon="image">{t('Library','المعرض')}</Button></div>}
    {s===3&&<div style={{display:'flex',flexDirection:'column',gap:10}}><Card onClick={()=>{}} style={{display:'flex',gap:12}}><Icon name="scan-line"/>{t('Upload vaccination card','ارفع كارت التطعيم')}</Card><Card onClick={()=>go('addvax')} style={{display:'flex',gap:12}}><Icon name="pencil"/>{t('Enter manually','أدخل يدوي')}</Card></div>}
    <div style={{marginTop:'auto',paddingBottom:24,display:'flex',gap:10}}>{s>0&&<Button variant="secondary" onClick={()=>setS(s-1)}>{t('Back','رجوع')}</Button>}<Button block onClick={()=>s<3?setS(s+1):go('passport')}>{s<3?t('Next','التالي'):t('Skip for now','تخطي دلوقتي')}</Button></div></div></Screen>}
function Passport(){const {t,go,st}=useL();const [tab,setTab]=React.useState(2);const [menu,setMenu]=React.useState(false);const [del,setDel]=React.useState(false);
  const tabs=[t('Overview','نظرة عامة'),t('Timeline','الخط الزمني'),t('Vaccinations','التطعيمات'),t('Records','السجلات'),t('Documents','المستندات')];
  const V=[[t('Rabies','السعار'),'overdue',t('Overdue','متأخر'),'12/10/2026',false],[t('FVRCP','الثلاثي'),'due_soon',t('Due soon','قرّب'),'23/10/2026',true],[t('Deworming','الديدان'),'up_to_date',t('Up to date','متحصّن'),'15/03/2027',true]];
  return <Screen header={<Header back="pets" title={t('Milo','ميلو')} right={<IconButton plain icon="ellipsis-vertical" label={t('More','المزيد')} onClick={()=>setMenu(!menu)}/>}/>} sheet={del&&<ConfirmSheet title={t('Delete Milo?','تحذف ميلو؟')} body={t('His passport and records will be removed after 30 days.','جواز صحته وسجلاته هتتمسح بعد 30 يوم.')} confirm={t('Delete pet','احذف الحيوان')} cancel={t('Cancel','إلغاء')} onCancel={()=>setDel(false)} onConfirm={()=>{setDel(false);go('pets')}}/>}>
    <div style={{padding:'0 16px 16px',display:'flex',flexDirection:'column',gap:14}}>
      {menu&&<Card pad={4} style={{position:'absolute',top:0,insetInlineEnd:16,zIndex:5,width:190}}>{[[t('Edit','تعديل'),'pencil',null],[t('Share passport','مشاركة الجواز'),'share-2',()=>go('passportshare')],[t('Delete','حذف'),'trash-2',()=>setDel(true)]].map(([l,i,f])=><div key={l} onClick={()=>{setMenu(false);f&&f()}} style={{display:'flex',gap:10,padding:12,color:i==='trash-2'?'var(--danger)':'inherit',cursor:'pointer'}}><Icon name={i} size={18}/>{l}</div>)}</Card>}
      <div style={{display:'flex',gap:14,alignItems:'center'}}><Photo w={84} h={84} r={42}/><div><div className="t-h2">{t('Milo','ميلو')}</div><div className="t-cap">{t('Persian cat · 2 years · 4.2 kg','قطة شيرازي · سنتين · 4.2 كجم')}</div></div></div>
      <div style={{display:'flex',gap:8,overflow:'auto'}}>{tabs.map((x,i)=><Chip key={i} on={tab===i} onClick={()=>setTab(i)}>{x}</Chip>)}</div>
      {tab===2?<ListState rows={3} emptyIcon="syringe" emptyTitle={t('No vaccinations yet','مفيش تطعيمات لسه')} emptyBody={t('Add the first one from the vaccination card.','ضيف أول تطعيم من الكارت.')} emptyAction={t('Add vaccination','إضافة تطعيم')} onAction={()=>go('addvax')}>
        {V.map(([n,s,sl,d,v])=><Card key={n} pad={14} style={{display:'flex',gap:12,alignItems:'center'}}><Icon name="syringe" style={{color:'var(--primary)'}}/><div style={{flex:1}}><div style={{fontWeight:600}}>{n}</div><div className="t-cap">{t('Next due','الموعد الجاي')} {ltr(d)}</div><div style={{marginTop:4,display:'flex',gap:6}}><StatusBadge status={s}>{sl}</StatusBadge><StatusBadge status={v?'verified':'self_reported'}>{v?t('Clinic verified','موثّق من العيادة'):t('Self-reported','مُدخل منك')}</StatusBadge></div></div></Card>)}<Button variant="outline" block icon="plus" onClick={()=>go('addvax')}>{t('Add vaccination','إضافة تطعيم')}</Button></ListState>:<div className="t-cap" style={{padding:24,textAlign:'center'}}>{tabs[tab]}</div>}
    </div></Screen>}
function AddVax(){const {t,go}=useL();
  return <Screen header={<Header back="passport" title={t('Add vaccination','إضافة تطعيم')}/>}><div style={{padding:'8px 20px',display:'flex',flexDirection:'column',gap:14}}><Input label={t('Vaccine type','نوع التطعيم')} icon="syringe" defaultValue="FVRCP"/><Input label={t('Date given','تاريخ التطعيم')} icon="calendar" defaultValue="23/10/2026" ltr/><Input label={t('Next due','الموعد الجاي')} icon="calendar-clock" defaultValue="23/10/2027" ltr hint={t('Filled from the vaccine interval. You can edit it.','اتملّى من فترة التطعيم. تقدر تعدّله.')}/><Input label={t('Batch number','رقم التشغيلة')} ltr/><Input label={t('Vet name','اسم الدكتور')}/><Button variant="secondary" icon="camera" block>{t('Photo of the card','صورة الكارت')}</Button><Button block onClick={()=>go('passport')}>{t('Save','حفظ')}</Button></div></Screen>}
function PassportShare(){const {t,go}=useL();
  return <Screen header={<Header back="passport" title={t('Passport','جواز الصحة')}/>}><div style={{padding:'8px 20px',display:'flex',flexDirection:'column',gap:16}}><Card tint pad={20} style={{display:'flex',flexDirection:'column',alignItems:'center',gap:10}}><Photo w={96} h={96} r={48}/><div className="t-h2">{t('Milo','ميلو')}</div><div className="t-cap">{t('Persian cat · Male · 2 years','قطة شيرازي · ذكر · سنتين')}</div><StatusBadge status="due_soon">{t('1 vaccine due','تطعيم واحد مستحق')}</StatusBadge><div style={{width:'100%',borderTop:'1px dashed var(--primary)',paddingTop:10,display:'flex',flexDirection:'column',gap:6}}>{['Rabies','FVRCP','Deworming'].map(v=><div key={v} style={{display:'flex',justifyContent:'space-between'}}><span>{v}</span><Icon name="circle-check" size={18} style={{color:'var(--success)'}}/></div>)}</div></Card><Button block icon="image">{t('Share as image','مشاركة كصورة')}</Button><Button variant="secondary" block icon="file-text">{t('Share as PDF','مشاركة كـ PDF')}</Button></div></Screen>}
function Notifications(){const {t,go}=useL();
  const N=[[t('Today','النهارده'),[['syringe',t('Milo: FVRCP due in 5 days','ميلو: تطعيم FVRCP بعد 5 أيام'),true,'passport'],['clock',t('Your turn is next at Paws Vet','دورك الجاي في عيادة باوز'),true,'booking']]],[t('Yesterday','إمبارح'),[['calendar-check',t('Booking confirmed for Tue 10:30','تم تأكيد حجز الثلاثاء 10:30'),false,'booking']]]];
  return <Screen header={<Header back="home" title={t('Notifications','الإشعارات')} right={<Button variant="ghost" size="s">{t('Mark all as read','تعليم الكل كمقروء')}</Button>}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:14}}><ListState emptyIcon="bell-off" emptyTitle={t('You are all caught up','مفيش إشعارات جديدة')}>{N.map(([d,l])=><div key={d}><div className="t-cap" style={{marginBottom:6}}>{d}</div>{l.map(([i,x,u,r])=><Card key={x} pad={12} onClick={()=>go(r)} style={{display:'flex',gap:12,alignItems:'center',marginBottom:8}}><Icon name={i} style={{color:'var(--primary)'}}/><div style={{flex:1}}>{x}</div>{u&&<i style={{width:8,height:8,borderRadius:4,background:'var(--primary)'}}/>}</Card>)}</div>)}</ListState></div></Screen>}
function Profile(){const {t,go}=useL();
  const R=[['user-round',t('Edit profile','تعديل البيانات'),null],['settings',t('Settings','الإعدادات'),'settings'],['shield',t('Account','الحساب'),'account'],['circle-help',t('Help','المساعدة'),null],['file-text',t('Legal','القانوني'),null],['info',t('About','عن التطبيق'),null]];
  return <Screen tab="profile" header={<Header title={t('Profile','حسابي')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:16}}><div style={{display:'flex',gap:14,alignItems:'center'}}><Avatar name="SA" size={64}/><div><div className="t-h2">{t('Sarah Ahmed','سارة أحمد')}</div><div className="t-cap">{ltr('+20 100 123 4567')}</div></div></div><Card pad={0}>{R.map(([i,l,r],k)=><div key={l} onClick={()=>r&&go(r)} style={{display:'flex',gap:12,alignItems:'center',padding:'14px 16px',borderTop:k?'1px solid var(--border)':0,cursor:'pointer',minHeight:44}}><Icon name={i} size={20} style={{color:'var(--primary)'}}/><span style={{flex:1}}>{l}</span><Icon name="chevron-right" flip size={18} style={{color:'var(--text-secondary)'}}/></div>)}</Card></div></Screen>}
function Settings(){const {t,go,lang,setLang,theme,setTheme}=useL();
  const Seg=({v,set,o})=><div style={{display:'flex',gap:8}}>{o.map(([k,l])=><Chip key={k} on={v===k} onClick={()=>set(k)}>{l}</Chip>)}</div>;
  return <Screen header={<Header back="profile" title={t('Settings','الإعدادات')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:18}}><div><div className="t-h3" style={{marginBottom:8}}>{t('Language','اللغة')}</div><Seg v={lang} set={setLang} o={[['ar','العربية'],['en','English']]}/></div><div><div className="t-h3" style={{marginBottom:8}}>{t('Theme','المظهر')}</div><Seg v={theme} set={setTheme} o={[['light',t('Light','فاتح')],['dark',t('Dark','داكن')]]}/></div>
    <div><div className="t-h3" style={{marginBottom:8}}>{t('Notifications','الإشعارات')}</div>{[t('Vaccination reminders','تذكير التطعيمات'),t('Booking updates','تحديثات الحجز'),t('Offers','العروض')].map((l,i)=><div key={l} style={{display:'flex',justifyContent:'space-between',alignItems:'center',minHeight:48}}>{l}<input type="checkbox" defaultChecked={i<2} style={{width:22,height:22,accentColor:'var(--primary)'}}/></div>)}</div></div></Screen>}
function Account(){const {t,go}=useL();const [d,setD]=React.useState(false);const [txt,setTxt]=React.useState('');
  return <Screen header={<Header back="profile" title={t('Account','الحساب')}/>} sheet={d&&<ConfirmSheet title={t('Delete account?','تحذف الحساب؟')} body={t('This removes your pets, files and profile. Type DELETE to confirm.','ده هيمسح حيواناتك وملفاتك وبياناتك. اكتب DELETE للتأكيد.')} confirm={t('Delete my account','احذف حسابي')} cancel={t('Cancel','إلغاء')} onCancel={()=>setD(false)} onConfirm={()=>txt==='DELETE'&&go('language')}><Input ltr placeholder="DELETE" value={txt} onChange={e=>setTxt(e.target.value)}/></ConfirmSheet>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:12}}>
    <Card pad={0}>{[['phone',t('Phone','الموبايل'),ltr('+20 100 ••• 4567'),true],['mail',t('Google','Google'),t('Not linked','مش مربوط'),false]].map(([i,l,v,on],k)=><div key={l} style={{display:'flex',gap:12,alignItems:'center',padding:14,borderTop:k?'1px solid var(--border)':0}}><Icon name={i}/><div style={{flex:1}}>{l}<div className="t-cap">{v}</div></div>{!on&&<Button size="s" variant="outline">{t('Link Google','ربط Google')}</Button>}</div>)}</Card>
    <Button variant="secondary" block icon="download">{t('Export my data','تصدير بياناتي')}</Button><Button variant="secondary" block icon="log-out" onClick={()=>go('language')}>{t('Log out','تسجيل الخروج')}</Button><Button variant="destructive" block icon="trash-2" onClick={()=>setD(true)}>{t('Delete account','حذف الحساب')}</Button></div></Screen>}
Object.assign(window,{Home,Pets,AddPet,Passport,AddVax,PassportShare,Notifications,Profile,Settings,Account});
})();