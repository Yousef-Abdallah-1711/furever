(()=>{
const DS=window.FurEverDesignSystem_f25da7;const {Button,Chip,Banner,Card,Icon,IconButton,StatusBadge,PhaseTag,Rating}=DS;
const {useL,Header,Screen,Photo,ltr}=window;
const Tag=()=>{const {t}=useL();return <Banner tone="info"><b>{t('Later phase','مرحلة لاحقة')}</b> · {t('Not part of the MVP. Hidden until its feature flag is on.','مش جزء من النسخة الأولى. مخفي لحد ما الفلاج يتفعّل.')}</Banner>};
function Shop(){const {t,go}=useL();
  return <Screen tab="home" header={<Header back="home" title={t('Shop','المتجر')} phase right={<IconButton plain icon="shopping-cart" label={t('Cart','السلة')} badge={2}/>}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:14}}><Tag/><div style={{display:'flex',gap:8,overflow:'auto'}}>{[t('Food','أكل'),t('Litter','رمل'),t('Toys','ألعاب'),t('Care','عناية')].map((x,i)=><Chip key={x} on={!i}>{x}</Chip>)}</div><Photo w="100%" h={110} r={16} label={t('promo banner','بانر عرض')}/>
    <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:12}}>{[[t('Cat food 2 kg','أكل قطط 2 كجم'),'420'],[t('Clumping litter','رمل متكتل'),'180'],[t('Dog chew toy','لعبة كلاب'),'95'],[t('Shampoo','شامبو'),'140']].map(([n,p])=><Card key={n} pad={10} style={{display:'flex',flexDirection:'column',gap:6}}><Photo w="100%" h={90} r={12}/><div style={{fontWeight:500}}>{n}</div><b dir="ltr">{p} EGP</b><Button size="s">{t('Add to cart','أضف للسلة')}</Button></Card>)}</div></div></Screen>}
function Community(){const {t}=useL();
  return <Screen tab="home" header={<Header back="home" title={t('Adoption and Mating','التبنّي والتزاوج')} phase/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:14}}><Tag/><div style={{display:'flex',gap:8}}><Chip on>{t('Adoption','تبنّي')}</Chip><Chip>{t('Mating','تزاوج')}</Chip><Chip icon="shield-check">{t('Verified only','موثّق فقط')}</Chip></div>
    {[[t('Luna · Cat · 1 year','لونا · قطة · سنة'),t('Giza','الجيزة')],[t('Rex · Dog · 2 years','ريكس · كلب · سنتين'),t('Cairo','القاهرة')]].map(([n,c])=><Card key={n} pad={12} style={{display:'flex',gap:12}}><Photo w={84} h={84}/><div style={{flex:1,display:'flex',flexDirection:'column',gap:6}}><b>{n}</b><div className="t-cap">{c}</div><div style={{display:'flex',gap:6}}><StatusBadge status="verified">{t('Verified','موثّق')}</StatusBadge><StatusBadge status="up_to_date">{t('Vaccinated','متحصّن')}</StatusBadge></div></div></Card>)}</div></Screen>}
function Prejoin(){const {t}=useL();
  return <Screen header={<Header back="booking" title={t('Video consultation','استشارة فيديو')} phase/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:14}}><Tag/><Photo w="100%" h={260} r={20} label={t('camera preview','معاينة الكاميرا')}/><Card pad={0}>{[['camera',t('Camera','الكاميرا')],['mic',t('Microphone','الميكروفون')],['wifi',t('Network','الشبكة')]].map(([i,l],k)=><div key={l} style={{display:'flex',gap:12,alignItems:'center',padding:14,borderTop:k?'1px solid var(--border)':0}}><Icon name={i}/><span style={{flex:1}}>{l}</span><StatusBadge status="completed">{t('OK','تمام')}</StatusBadge></div>)}</Card><Button block disabled>{t('Join opens 10 min before','الدخول قبل الميعاد بـ 10 دقايق')}</Button></div></Screen>}
Object.assign(window,{Shop,Community,Prejoin});
})();