(()=>{
const DS=window.FurEverDesignSystem_f25da7;const {Button,Icon,Banner,Chip,Card,Input,Avatar,StatusBadge}=DS;
const {useE,ESCREEN:Screen,EHeader:Header,ESteps:Steps,ESheet:Sheet,EPick:Pick,ECITIES:CITIES}=window;
const PHOTOS=[['#DAB7B5','Milo-1'],['#B9A9A8','Milo-2'],['#EEDAD7','Milo-3']];
function Profile(){const {t,go,st,set,next,lang,toast}=useE();
  const [name,setName]=React.useState(st.user.name||'');const [city,setCity]=React.useState(st.user.city||'');const [ok,setOk]=React.useState(!!st.user.consent);const [av,setAv]=React.useState(!!st.user.avatar);const [er,setEr]=React.useState({});const [sh,setSh]=React.useState(null);
  const save=()=>{const e={};if(name.trim().length<2)e.name=t('Enter your full name','اكتب اسمك بالكامل');if(!city)e.city=t('Choose your city','اختار مدينتك');if(!ok)e.ok=t('Please accept the Terms and Privacy Policy','لازم توافق على الشروط وسياسة الخصوصية');setEr(e);if(Object.keys(e).length)return;set({user:{name:name.trim(),city,consent:true,avatar:av}});next('petSpecies')};
  const cn=k=>{const c=CITIES.find(x=>x[0]===k);return c?(lang==='ar'?c[1]:c[0]):''};
  return <Screen header={<Header back={st.mode==='signup'?'otp':'profileTab'} title={t('Complete your profile','أكمل بياناتك')}/>}>
    <Steps n={0}/><div style={{padding:'8px 24px 24px',display:'flex',flexDirection:'column',gap:16}}>
    {st.social&&<Banner tone="info">{t('Name filled from your '+st.social+' account. City is still required.','الاسم اتملّى من حساب '+st.social+'. لسه لازم تختار المدينة.')}</Banner>}
    <button onClick={()=>setSh('av')} aria-label="avatar" style={{alignSelf:'center',position:'relative',border:0,background:'none',cursor:'pointer'}}>{av?<div className="fe-ph" style={{width:88,height:88,borderRadius:'50%',background:'#DAB7B5'}}>photo</div>:<Avatar name={name||'?'} size={88}/>}<span style={{position:'absolute',bottom:0,insetInlineEnd:0,background:'var(--primary)',color:'var(--on-primary)',borderRadius:'50%',padding:6,display:'flex'}}><Icon name="camera" size={16}/></span></button>
    <Input label={t('Full name','الاسم بالكامل')} value={name} onChange={e=>{setName(e.target.value);setEr({...er,name:null})}} error={er.name} placeholder={t('e.g. Sarah Ahmed','مثلًا سارة أحمد')}/>
    <div className="fe-field"><span className="fe-label">{t('City','المدينة')}</span><button onClick={()=>setSh('city')} className={'fe-input'+(er.city?' error':'')} style={{display:'flex',alignItems:'center',gap:8,textAlign:'start',cursor:'pointer',fontFamily:'inherit',color:city?'var(--text-primary)':'var(--text-secondary)'}}><Icon name="map-pin" size={20}/><span style={{flex:1}}>{city?cn(city):t('Select city','اختار المدينة')}</span><Icon name="chevron-down" size={18}/></button>{er.city&&<span className="fe-hint error">{er.city}</span>}</div>
    <div><label style={{display:'flex',gap:10,alignItems:'center',cursor:'pointer'}}><input type="checkbox" checked={ok} onChange={e=>{setOk(e.target.checked);setEr({...er,ok:null})}} style={{width:22,height:22,accentColor:'var(--primary)'}}/><span>{t('I agree to the Terms and Privacy Policy','موافق على الشروط وسياسة الخصوصية')}</span></label>{er.ok&&<div className="fe-hint error" style={{marginTop:4}}>{er.ok}</div>}</div>
    <Button block onClick={save}>{t('Save and continue','حفظ ومتابعة')}</Button></div>
    {sh==='city'&&<Sheet title={t('Select city','اختار المدينة')} onClose={()=>setSh(null)}><Pick sel={city} onPick={k=>{setCity(k);setEr({...er,city:null});setSh(null)}} items={CITIES.map(c=>[c[0],lang==='ar'?c[1]:c[0]])}/></Sheet>}
    {sh==='av'&&<Sheet sim title={t('Profile photo','صورة الحساب')} onClose={()=>setSh(null)}><Pick onPick={k=>{setAv(k==='pick');setSh(null);toast(k==='pick'?t('Photo added','تمت إضافة الصورة'):t('Photo removed','تم حذف الصورة'),true)}} items={[['pick',t('Choose from library','اختار من المعرض')],['rm',t('Remove photo','حذف الصورة')]]}/></Sheet>}</Screen>}
function Species(){const {t,go,st,set,next}=useE();const sp=st.pet.species;
  const O=[['cat','cat',t('Cat','قطة')],['dog','dog',t('Dog','كلب')],['bird','bird',t('Bird','طائر')],['rabbit','rabbit',t('Rabbit','أرنب')],['other','paw-print',t('Other','تاني')]];
  return <Screen header={<Header back="profile" title={t('Add your first pet','ضيف أول حيوان')} sub={t('Step 1 of 4 · Species','الخطوة 1 من 4 · النوع')}/>}><Steps n={1}/><div style={{padding:'8px 24px 24px',display:'flex',flexDirection:'column',gap:16}}>
    <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:12}}>{O.map(([k,i,l])=><Card key={k} tint={sp===k} onClick={()=>set({pet:{...st.pet,species:k,breed:''}})} pad={20} style={{display:'flex',flexDirection:'column',alignItems:'center',gap:8}}><Icon name={i} size={36} style={{color:'var(--primary)'}}/>{l}</Card>)}</div>
    <Button block disabled={!sp} onClick={()=>next('petBasics')}>{t('Continue','متابعة')}</Button>{!sp&&<div className="fe-hint" style={{textAlign:'center'}}>{t('Choose a species to continue','اختار النوع عشان تكمّل')}</div>}
    <Button variant="ghost" block onClick={()=>next('perms')}>{t('I will add a pet later','هضيف حيوان بعدين')}</Button></div></Screen>}
const BREEDS={cat:[['Persian','شيرازي'],['Siamese','سيامي'],['British Shorthair','بريتيش شورت هير'],['Mixed','مختلط']],dog:[['Golden Retriever','جولدن ريتريفر'],['German Shepherd','جيرمن شيبرد'],['Husky','هاسكي'],['Mixed','مختلط']],other:[['Other','تاني']]};
function Basics(){const {t,go,st,set,next,lang}=useE();const p=st.pet;
  const [f,setF]=React.useState({name:p.name||'',breed:p.breed||'',gender:p.gender||'',mode:p.mode||'date',birth:p.birth||'',years:p.years??2,months:p.months??0,weight:p.weight||''});const [er,setEr]=React.useState({});const [bq,setBq]=React.useState('');const [sh,setSh]=React.useState(false);
  const U=(k,v)=>{setF({...f,[k]:v});setEr({...er,[k]:null})};
  const list=(BREEDS[p.species]||BREEDS.other).filter(b=>(b[0]+b[1]).toLowerCase().includes(bq.toLowerCase()));
  const save=()=>{const e={};if(f.name.trim().length<1)e.name=t('Enter your pet\'s name','اكتب اسم حيوانك');if(!f.breed)e.breed=t('Choose a breed','اختار السلالة');if(!f.gender)e.gender=t('Choose a gender','اختار النوع (ذكر/أنثى)');if(f.mode==='date'){if(!f.birth)e.birth=t('Enter a birth date','اكتب تاريخ الميلاد');else if(new Date(f.birth)>window.ETODAY)e.birth=t('Birth date cannot be in the future','تاريخ الميلاد مينفعش يكون في المستقبل')}if(f.weight&&!(+f.weight>0&&+f.weight<120))e.weight=t('Enter a valid weight in kg','اكتب وزن صحيح بالكيلو');setEr(e);if(Object.keys(e).length)return;set({pet:{...p,...f,name:f.name.trim()}});next('petPhoto')};
  const age=f.mode==='years'?null:null;
  return <Screen header={<Header back="petSpecies" title={t('About your pet','عن حيوانك')} sub={t('Step 2 of 4 · Basics','الخطوة 2 من 4 · الأساسيات')}/>}><Steps n={1}/><div style={{padding:'8px 24px 24px',display:'flex',flexDirection:'column',gap:14}}>
    <Input label={t('Name','الاسم')} value={f.name} onChange={e=>U('name',e.target.value)} error={er.name} placeholder={t('e.g. Milo','مثلًا ميلو')}/>
    <div className="fe-field"><span className="fe-label">{t('Breed','السلالة')}</span><button onClick={()=>setSh(true)} className={'fe-input'+(er.breed?' error':'')} style={{display:'flex',alignItems:'center',gap:8,textAlign:'start',cursor:'pointer',fontFamily:'inherit',color:f.breed?'var(--text-primary)':'var(--text-secondary)'}}><Icon name="search" size={18}/><span style={{flex:1}}>{f.breed||t('Search breed','دوّر على السلالة')}</span></button>{er.breed&&<span className="fe-hint error">{er.breed}</span>}</div>
    <div className="fe-field"><span className="fe-label">{t('Gender','النوع')}</span><div style={{display:'flex',gap:8}}>{[['male',t('Male','ذكر')],['female',t('Female','أنثى')],['unknown',t('Unknown','غير معروف')]].map(([k,l])=><Chip key={k} on={f.gender===k} onClick={()=>U('gender',k)}>{l}</Chip>)}</div>{er.gender&&<span className="fe-hint error">{er.gender}</span>}</div>
    <div className="fe-field"><span className="fe-label">{t('Age','العمر')}</span><div style={{display:'flex',gap:8}}><Chip on={f.mode==='date'} onClick={()=>U('mode','date')}>{t('Birth date','تاريخ الميلاد')}</Chip><Chip on={f.mode==='years'} onClick={()=>U('mode','years')}>{t('Approximate age','عمر تقريبي')}</Chip></div>
      {f.mode==='date'?<><input type="date" className={'fe-input'+(er.birth?' error':'')} value={f.birth} onChange={e=>U('birth',e.target.value)} dir="ltr" style={{textAlign:'start'}}/>{er.birth&&<span className="fe-hint error">{er.birth}</span>}</>:<div style={{display:'flex',gap:12,alignItems:'center'}}>{[['years',t('years','سنة'),20],['months',t('months','شهر'),11]].map(([k,l,mx])=><div key={k} style={{display:'flex',alignItems:'center',gap:8,flex:1}}><Button size="s" variant="secondary" onClick={()=>U(k,Math.max(0,f[k]-1))}>-</Button><b dir="ltr" style={{minWidth:24,textAlign:'center'}}>{f[k]}</b><Button size="s" variant="secondary" onClick={()=>U(k,Math.min(mx,f[k]+1))}>+</Button><span className="t-cap">{l}</span></div>)}</div>}</div>
    <Input label={t('Weight in kg (optional)','الوزن بالكيلو (اختياري)')} ltr inputMode="decimal" value={f.weight} onChange={e=>U('weight',e.target.value)} error={er.weight} placeholder="4.2"/>
    <Button block onClick={save}>{t('Continue','متابعة')}</Button></div>
    {sh&&<Sheet title={t('Choose breed','اختار السلالة')} onClose={()=>setSh(false)}><Input icon="search" placeholder={t('Search','بحث')} value={bq} onChange={e=>setBq(e.target.value)}/><div style={{marginTop:8}}><Pick sel={f.breed} onPick={k=>{U('breed',k);setSh(false)}} items={list.map(b=>[b[0],lang==='ar'?b[1]:b[0]])}/>{!list.length&&<div className="t-cap" style={{padding:16,textAlign:'center'}}>{t('No match. Choose Other or Mixed.','مفيش نتيجة. اختار تاني أو مختلط.')}</div>}</div></Sheet>}</Screen>}
function PetPhoto(){const {t,go,st,set,next,toast}=useE();const p=st.pet;const [sh,setSh]=React.useState(false);
  return <Screen header={<Header back="petBasics" title={t('Add a photo','ضيف صورة')} sub={t('Step 3 of 4 · Optional','الخطوة 3 من 4 · اختياري')}/>}><Steps n={1}/><div style={{padding:'8px 24px 24px',display:'flex',flexDirection:'column',alignItems:'center',gap:14}}>
    <div className="fe-ph" style={{width:200,height:200,borderRadius:'50%',background:p.photo?p.photo:undefined,color:p.photo?'#4A4A4A':undefined}}>{p.photo?t('Photo of ','صورة ')+p.name:t('No photo yet','مفيش صورة لسه')}</div>
    <div style={{display:'flex',gap:8,flexWrap:'wrap',justifyContent:'center'}}><Button size="m" variant="secondary" icon="camera" onClick={()=>setSh(true)}>{t('Camera','الكاميرا')}</Button><Button size="m" variant="secondary" icon="image" onClick={()=>setSh(true)}>{t('Library','المعرض')}</Button>{p.photo&&<Button size="m" variant="ghost" icon="trash-2" onClick={()=>set({pet:{...p,photo:''}})}>{t('Remove','حذف')}</Button>}</div>
    <Button block onClick={()=>next('petHealth')}>{p.photo?t('Continue','متابعة'):t('Skip for now','تخطي دلوقتي')}</Button></div>
    {sh&&<Sheet sim title={t('Choose a photo','اختار صورة')} onClose={()=>setSh(false)}><div style={{display:'flex',gap:10}}>{PHOTOS.map(([c,n])=><button key={n} onClick={()=>{set({pet:{...p,photo:c}});setSh(false);toast(t('Photo selected','تم اختيار الصورة'),true)}} style={{flex:1,height:96,borderRadius:12,border:'1px solid var(--border)',background:c,cursor:'pointer',fontFamily:'inherit',color:'#4A4A4A'}}>{n}</button>)}</div><div className="t-cap" style={{marginTop:8}}>{t('Mock picker. No real camera or files are accessed.','اختيار تجريبي. مفيش وصول حقيقي للكاميرا أو الملفات.')}</div></Sheet>}</Screen>}
Object.assign(window,{EProfile:Profile,ESpecies:Species,EBasics:Basics,EPetPhoto:PetPhoto});
})();