(()=>{
const DS=window.FurEverDesignSystem_f25da7;const {Button,Icon,IconButton,Banner,Chip,Card,Avatar,StatusBadge,EmptyState,ClinicCard,SlotChip,Rating,Input}=DS;
const {useE,ESCREEN:Screen,EHeader:Header,ESheet:Sheet,eFmt:fmt,eVaxStatus:vaxStatus,eSLabel:sLabel,eltr:ltr}=window;
const hasPet=st=>!!st.pet.name;
function Home(){const {t,go,goWith,st,lang}=useE();const p=st.pet;const vs=st.health.vax?vaxStatus(st.health.vax.next):null;const first=(st.user.name||'').split(' ')[0];
  return <Screen tab="home"><div style={{background:'linear-gradient(var(--bg-gradient-top),var(--bg-gradient-bottom))',padding:'8px 16px 16px'}}>
    <div style={{display:'flex',alignItems:'center',gap:12,marginBottom:14}}><Avatar name={st.user.name} size={44}/><div style={{flex:1}}><div className="t-cap">{t('Good morning','صباح الخير')}</div><div className="t-h3">{first}</div></div><IconButton icon="bell" label={t('Notifications','الإشعارات')} badge={st.notifRead?0:2} onClick={()=>go('notifs')}/></div>
    <button onClick={()=>go('clinics')} className="fe-input" style={{display:'flex',alignItems:'center',gap:10,background:'var(--surface-secondary)',borderColor:'transparent',color:'var(--text-secondary)',cursor:'pointer',fontFamily:'inherit',textAlign:'start'}}><Icon name="search" size={20}/>{t('Search clinics, vets…','دوّر على عيادة أو دكتور…')}</button></div>
  <div style={{padding:'0 16px 16px',display:'flex',flexDirection:'column',gap:16}}>
    <div style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:10}}>{[['stethoscope',t('Vet Clinics','عيادات'),'clinics'],['paw-print',t('My Pets','حيواناتي'),'pets'],['siren',t('Emergency','طوارئ'),'emergency']].map(([i,l,r])=><Card key={r} tint pad={14} onClick={()=>go(r)} style={{display:'flex',flexDirection:'column',alignItems:'center',gap:8,textAlign:'center'}}><Icon name={i} size={28} style={{color:r==='emergency'?'var(--danger)':'var(--primary)'}}/><span style={{fontWeight:500}}>{l}</span></Card>)}</div>
    {hasPet(st)?<>
      <Card onClick={()=>go('petDetail')} pad={12} style={{display:'flex',gap:12,alignItems:'center'}}><div className="fe-ph" style={{width:64,height:64,borderRadius:32,background:p.photo||undefined}}/><div style={{flex:1}}><div className="t-h3">{p.name}</div><div className="t-cap">{p.breed}</div><div style={{marginTop:6}}>{vs?<StatusBadge status={vs}>{sLabel(t,vs)}</StatusBadge>:<StatusBadge status="self_reported">{t('No health info yet','مفيش معلومات صحية')}</StatusBadge>}</div></div><Icon name="chevron-right" flip size={20}/></Card>
      {vs?<Banner tone={vs==='overdue'?'danger':vs==='due_soon'?'warning':'success'} action={<Button size="s" variant="outline" onClick={()=>go('petDetail')}>{t('View','عرض')}</Button>}>{st.health.vax.type} · {t('next due ','الموعد الجاي ')}{ltr(fmt(st.health.vax.next))}</Banner>
      :<Card tint pad={14} style={{display:'flex',flexDirection:'column',gap:8}}><div style={{display:'flex',gap:10,alignItems:'center'}}><Icon name="syringe" style={{color:'var(--primary)'}}/><b>{t('Add '+p.name+'\'s vaccinations','ضيف تطعيمات '+p.name)}</b></div><div className="t-cap">{t('Get reminders before each vaccine is due.','هتوصلك تذكيرات قبل كل ميعاد.')}</div><Button size="m" onClick={()=>goWith('vaxForm','home')}>{t('Add vaccination','إضافة تطعيم')}</Button></Card>}
    </>:<Card tint pad={16} style={{display:'flex',flexDirection:'column',gap:8,alignItems:'center',textAlign:'center'}}><Icon name="paw-print" size={32} style={{color:'var(--primary)'}}/><b>{t('Add your first pet','ضيف أول حيوان')}</b><Button size="m" onClick={()=>goWith('petSpecies','home')}>{t('Add pet','إضافة حيوان')}</Button></Card>}
    {st.booking?<Card onClick={()=>go('bookings')} style={{display:'flex',flexDirection:'column',gap:6}}><div style={{display:'flex',justifyContent:'space-between'}}><span className="t-cap">{t('Next appointment','الحجز الجاي')}</span><StatusBadge status="confirmed">{t('Confirmed','مؤكد')}</StatusBadge></div><b>{t('Paws Vet Clinic','عيادة باوز البيطرية')}</b><div className="t-cap">{t('Tue 20 Oct','الثلاثاء 20 أكتوبر')} · {ltr(st.booking)}</div></Card>
    :<Card pad={14} onClick={()=>go('clinics')} style={{display:'flex',gap:12,alignItems:'center'}}><Icon name="calendar-plus" style={{color:'var(--primary)'}}/><div style={{flex:1}}><b>{t('Book a clinic visit','احجز زيارة عيادة')}</b><div className="t-cap">{t('See live queue and next free slots.','شوف الطابور المباشر وأقرب مواعيد.')}</div></div><Icon name="chevron-right" flip size={18}/></Card>}
    <Button variant="destructive" block icon="siren" onClick={()=>go('emergency')}>{t('Emergency vets near me','أقرب طوارئ بيطرية')}</Button></div></Screen>}
function Pets(){const {t,go,goWith,st,toast}=useE();const p=st.pet;const vs=st.health.vax?vaxStatus(st.health.vax.next):null;
  return <Screen tab="pets" header={<Header title={t('My Pets','حيواناتي')} right={<Button size="s" icon="plus" onClick={()=>hasPet(st)?toast(t('This prototype keeps one pet. The full Add pet flow is in the Owner app kit.','النموذج ده فيه حيوان واحد. فلو إضافة حيوان كامل في Owner app kit.'),true):goWith('petSpecies','pets')}>{t('Add pet','إضافة')}</Button>}/>}><div style={{padding:16}}>
    {hasPet(st)?<Card onClick={()=>go('petDetail')} pad={12} style={{display:'flex',gap:12,alignItems:'center'}}><div className="fe-ph" style={{width:64,height:64,borderRadius:14,background:p.photo||undefined}}/><div style={{flex:1}}><b>{p.name}</b><div className="t-cap">{p.breed}</div><div style={{marginTop:6}}>{vs?<StatusBadge status={vs}>{sLabel(t,vs)}</StatusBadge>:<StatusBadge status="self_reported">{t('No health info','مفيش معلومات')}</StatusBadge>}</div></div><Icon name="chevron-right" flip size={20}/></Card>
    :<EmptyState icon="paw-print" title={t('No pets yet','لسه مفيش حيوانات')} body={t('Add your first pet to start a health passport.','ضيف أول حيوان عشان تبدأ جواز الصحة.')} action={t('Add pet','إضافة حيوان')} onAction={()=>goWith('petSpecies','pets')}/>}</div></Screen>}
function PetDetail(){const {t,go,goWith,st}=useE();const p=st.pet;const v=st.health.vax;const vs=v?vaxStatus(v.next):null;if(!p.name){return null}
  return <Screen header={<Header back="pets" title={p.name}/>}><div style={{padding:'0 16px 16px',display:'flex',flexDirection:'column',gap:14}}>
    <div style={{display:'flex',gap:14,alignItems:'center'}}><div className="fe-ph" style={{width:84,height:84,borderRadius:42,background:p.photo||undefined}}/><div><div className="t-h2">{p.name}</div><div className="t-cap">{p.breed}{p.weight?' · '+p.weight+' kg':''}</div></div></div>
    <div className="t-h3">{t('Vaccinations','التطعيمات')}</div>
    {v?<Card pad={14} style={{display:'flex',gap:12,alignItems:'center'}}><Icon name="syringe" style={{color:'var(--primary)'}}/><div style={{flex:1}}><b>{v.type}</b><div className="t-cap">{t('Given ','اتاخد ')}{ltr(fmt(v.given))} · {t('next due ','الجاي ')}{ltr(fmt(v.next))}</div><div style={{display:'flex',gap:6,marginTop:6}}><StatusBadge status={vs}>{sLabel(t,vs)}</StatusBadge><StatusBadge status="self_reported">{t('Self-reported','مُدخل منك')}</StatusBadge></div></div></Card>:<EmptyState icon="syringe" title={t('No vaccinations yet','مفيش تطعيمات لسه')} body={t('Add the first one from the vaccination card.','ضيف أول تطعيم من الكارت.')}/>}
    <Button variant={v?'outline':'primary'} block icon="plus" onClick={()=>goWith('vaxForm','petDetail')}>{t('Add vaccination','إضافة تطعيم')}</Button></div></Screen>}
function Bookings(){const {t,go,st}=useE();
  return <Screen tab="bookings" header={<Header title={t('My bookings','حجوزاتي')}/>}><div style={{padding:16}}>{st.booking?<Card onClick={()=>go('home')} style={{display:'flex',flexDirection:'column',gap:6}}><div style={{display:'flex',justifyContent:'space-between'}}><b>{t('Paws Vet Clinic','عيادة باوز البيطرية')}</b><StatusBadge status="confirmed">{t('Confirmed','مؤكد')}</StatusBadge></div><div className="t-cap">{t('Tue 20 Oct','الثلاثاء 20 أكتوبر')} · {ltr(st.booking)} · {st.pet.name||t('Pet','حيوان')}</div></Card>:<EmptyState icon="calendar-x" title={t('No bookings yet','مفيش حجوزات لسه')} body={t('Find a clinic and pick a time.','دوّر على عيادة واختار ميعاد.')} action={t('Find a clinic','دوّر على عيادة')} onAction={()=>go('clinics')}/>}</div></Screen>}
function ProfileTab(){const {t,go,goWith,st,lang,setLang,theme,setTheme,restart,logout,openSheet,closeSheet,editFromSummary}=useE();
  const Seg=({v,s,o})=><div style={{display:'flex',gap:8}}>{o.map(([k,l])=><Chip key={k} on={v===k} onClick={()=>s(k)}>{l}</Chip>)}</div>;
  const R=[['user-round',t('Edit profile','تعديل البيانات'),()=>goWith('profile','profileTab')],['clipboard-list',t('Review setup summary','مراجعة ملخص الإعداد'),()=>go('summary')],['circle-help',t('Help','المساعدة'),()=>openSheet(<Sheet title={t('Help','المساعدة')} onClose={closeSheet}><div className="t-cap" style={{marginBottom:12}}>{t('FAQ and contact options appear here.','الأسئلة الشائعة وطرق التواصل هنا.')}</div><Button block onClick={closeSheet}>{t('Close','إغلاق')}</Button></Sheet>)]];
  return <Screen tab="profileTab" header={<Header title={t('Profile','حسابي')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:16}}>
    <div style={{display:'flex',gap:14,alignItems:'center'}}><Avatar name={st.user.name} size={64}/><div><div className="t-h2">{st.user.name}</div><div className="t-cap">{ltr('+20 '+(st.phone||'100 123 4567'))}</div></div></div>
    <Card pad={0}>{R.map(([i,l,f],k)=><button key={l} onClick={f} style={{display:'flex',gap:12,alignItems:'center',width:'100%',padding:'14px 16px',border:0,borderTop:k?'1px solid var(--border)':0,background:'none',color:'var(--text-primary)',fontFamily:'inherit',fontSize:'var(--fs-body-lg)',cursor:'pointer',minHeight:48,textAlign:'start'}}><Icon name={i} size={20} style={{color:'var(--primary)'}}/><span style={{flex:1}}>{l}</span><Icon name="chevron-right" flip size={18}/></button>)}</Card>
    <div><div className="t-h3" style={{marginBottom:8}}>{t('Language','اللغة')}</div><Seg v={lang} s={setLang} o={[['ar','العربية'],['en','English']]}/></div>
    <div><div className="t-h3" style={{marginBottom:8}}>{t('Theme','المظهر')}</div><Seg v={theme} s={setTheme} o={[['light',t('Light','فاتح')],['dark',t('Dark','داكن')]]}/></div>
    <Button variant="secondary" block icon="log-out" onClick={logout}>{t('Log out','تسجيل الخروج')}</Button></div></Screen>}
const CL=[['Paws Vet Clinic','عيادة باوز البيطرية','1.2 km','4.8','10:30',['near','open']],['Happy Tails','هابي تيلز','2.6 km','4.6','11:00',['near','open']],['Nile 24h Pet Hospital','مستشفى النيل 24 ساعة','4.1 km','4.9','Now',['open','h24']]];
function Clinics(){const {t,go,lang,set}=useE();const [f,setF]=React.useState([]);const [q,setQ]=React.useState('');
  const tog=k=>setF(f.includes(k)?f.filter(x=>x!==k):[...f,k]);
  const L=CL.filter(c=>f.every(x=>c[5].includes(x))&&(c[0]+c[1]).toLowerCase().includes(q.toLowerCase()));
  return <Screen header={<Header back="home" title={t('Clinics','العيادات')}/>}><div style={{padding:'0 16px 16px',display:'flex',flexDirection:'column',gap:12}}><Input icon="search" placeholder={t('Search clinics','دوّر على عيادة')} value={q} onChange={e=>setQ(e.target.value)}/>
    <div style={{display:'flex',gap:8,overflow:'auto'}}>{[['near',t('Near me','قريب مني'),'map-pin'],['open',t('Open now','مفتوح دلوقتي')],['h24',t('24 hours','24 ساعة')]].map(([k,l,i])=><Chip key={k} on={f.includes(k)} icon={i} onClick={()=>tog(k)}>{l}</Chip>)}</div>
    {L.length?L.map((c,i)=><ClinicCard key={i} name={lang==='ar'?c[1]:c[0]} distance={c[2]} rating={c[3]} next={c[4]} nextLabel={t('Next:','أقرب موعد:')} onClick={()=>{set({clinic:i});go('clinicDetail')}}/>):<EmptyState icon="search-x" title={t('No clinics match','مفيش عيادات مطابقة')} action={t('Clear filters','مسح الفلاتر')} onAction={()=>{setF([]);setQ('')}}/>}</div></Screen>}
function BookSheet({onClose}){const {t,set,toast,go}=useE();const [s,setS]=React.useState('');
  return <Sheet sim title={t('Pick a time','اختار الميعاد')} onClose={onClose}><div className="t-cap" style={{marginBottom:8}}>{t('Tue 20 Oct · Cairo time. The full 5-step booking flow is in the Owner app kit.','الثلاثاء 20 أكتوبر · بتوقيت القاهرة. فلو الحجز الكامل (5 خطوات) في Owner app kit.')}</div><div style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:8,marginBottom:14}}>{[['09:30'],['10:00'],['10:30'],['11:00',1],['11:30'],['12:00']].map(([x,d])=><SlotChip key={x} time={x} disabled={!!d} on={s===x} onClick={()=>setS(x)}/>)}</div><Button block disabled={!s} onClick={()=>{set({booking:s});onClose();toast(t('Booking confirmed','تم تأكيد الحجز'),true);go('bookings')}}>{t('Confirm booking','تأكيد الحجز')}</Button></Sheet>}
function ClinicDetail(){const {t,go,lang,st,toast,openSheet,closeSheet}=useE();const c=CL[st.clinic||0];
  return <Screen header={<Header back="clinics" title={lang==='ar'?c[1]:c[0]}/>}><div style={{padding:'0 16px 90px',display:'flex',flexDirection:'column',gap:14}}><div className="fe-ph" style={{height:150,borderRadius:16}}>cover photo</div><div style={{display:'flex',gap:10,alignItems:'center'}}><Rating value={5} size={16}/><span dir="ltr">{c[3]}</span><StatusBadge status="completed">{t('Open','مفتوح')}</StatusBadge></div>
    <div style={{display:'flex',gap:8}}>{[['phone',t('Call','اتصال')],['message-circle','WhatsApp'],['navigation',t('Directions','الاتجاهات')]].map(([i,l])=><Button key={l} size="m" variant="secondary" icon={i} style={{flex:1}} onClick={()=>toast(l+' · '+t('opens the phone app','بيفتح تطبيق الموبايل'),true)}>{l}</Button>)}</div>
    <div style={{color:'var(--text-secondary)'}}>{t('Vaccinations, check-ups, surgery and lab tests.','تطعيمات، كشف، جراحة وتحاليل.')}</div></div>
    <div style={{position:'absolute',bottom:0,insetInline:0,padding:'12px 16px 20px',background:'var(--surface)',borderTop:'1px solid var(--border)'}}><Button block onClick={()=>openSheet(<BookSheet onClose={closeSheet}/>)}>{t('Book now','احجز دلوقتي')}</Button></div></Screen>}
function Notifs(){const {t,go,st,set}=useE();const read=st.notifRead;
  const N=[['syringe',st.health.vax?t('Reminder: '+st.health.vax.type+' due soon','تذكير: '+st.health.vax.type+' قرّب'):t('Welcome to FurEver','أهلاً بيك في فيرايفر'),'home'],['sparkles',t('Add your pet\'s health info any time','ضيف معلومات حيوانك الصحية في أي وقت'),'petDetail']];
  return <Screen header={<Header back="home" title={t('Notifications','الإشعارات')} right={<Button variant="ghost" size="s" onClick={()=>set({notifRead:true})}>{t('Mark all as read','تعليم الكل كمقروء')}</Button>}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:8}}>{N.map(([i,x,r])=><Card key={x} pad={12} onClick={()=>go(r==='petDetail'&&!st.pet.name?'home':r)} style={{display:'flex',gap:12,alignItems:'center'}}><Icon name={i} style={{color:'var(--primary)'}}/><div style={{flex:1}}>{x}</div>{!read&&<i style={{width:8,height:8,borderRadius:4,background:'var(--primary)'}}/>}</Card>)}</div></Screen>}
function Emergency(){const {t,go,lang,toast}=useE();
  return <Screen header={<Header back="home" title={t('Emergency','الطوارئ')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:12}}><Banner tone="danger">{t('Emergency vets near you','أقرب دكاترة طوارئ ليك')}</Banner><Banner tone="info">{t('Location is off. Showing clinics in Cairo.','الموقع مقفول. بنعرض عيادات القاهرة.')}</Banner>
    {[CL[2],['Vet Rescue Maadi','فيت ريسكيو المعادي','5.3 km']].map(c=><Card key={c[0]} style={{display:'flex',flexDirection:'column',gap:10}}><div style={{display:'flex',justifyContent:'space-between'}}><b>{lang==='ar'?c[1]:c[0]}</b><span dir="ltr" className="t-cap">{c[2]}</span></div><div style={{display:'flex',gap:8}}><Button variant="destructive" icon="phone" style={{flex:1}} onClick={()=>toast(t('Calling clinic','بيتصل بالعيادة'),true)}>{t('Call','اتصال')}</Button><Button variant="secondary" icon="navigation" style={{flex:1}} onClick={()=>toast(t('Opening maps','بيفتح الخرائط'),true)}>{t('Directions','الاتجاهات')}</Button></div></Card>)}</div></Screen>}
Object.assign(window,{EHome:Home,EPets:Pets,EPetDetail:PetDetail,EBookings:Bookings,EProfileTab:ProfileTab,EClinics:Clinics,EClinicDetail:ClinicDetail,ENotifs:Notifs,EEmergency:Emergency});
})();