(()=>{
const DS=window.FurEverDesignSystem_f25da7;const {Button,Input,Chip,Banner,Card,Icon,IconButton,Avatar,StatusBadge,ClinicCard,SlotChip,Stepper,ConfirmSheet,Rating}=DS;
const {useL,Header,Screen,Photo,ListState,ltr}=window;
function Clinics(){const {t,go}=useL();const [f,setF]=React.useState('near');
  const C=[[t('Paws Vet Clinic','عيادة باوز البيطرية'),'1.2 km','4.8','10:30',<StatusBadge status="completed">{t('Open','مفتوح')}</StatusBadge>],[t('Happy Tails','هابي تيلز'),'2.6 km','4.6','11:00',<StatusBadge status="completed">{t('Open','مفتوح')}</StatusBadge>],[t('Nile 24h Pet Hospital','مستشفى النيل 24 ساعة'),'4.1 km','4.9','Now',<StatusBadge status="info">24h</StatusBadge>]];
  return <Screen header={<Header back="home" title={t('Clinics','العيادات')}/>}><div style={{padding:'0 16px 16px',display:'flex',flexDirection:'column',gap:12}}>
    <Input icon="search" placeholder={t('Search clinics','دوّر على عيادة')}/>
    <div style={{display:'flex',gap:8,overflow:'auto'}}>{[['near',t('Near me','قريب مني'),'map-pin'],['open',t('Open now','مفتوح دلوقتي')],['24',t('24 hours','24 ساعة')],['em',t('Emergency','طوارئ')],['4',t('4+ rating','تقييم 4+')]].map(([k,l,i])=><Chip key={k} on={f===k} icon={i} onClick={()=>setF(k)}>{l}</Chip>)}</div>
    <ListState emptyIcon="search-x" emptyTitle={t('No clinics match','مفيش عيادات مطابقة')} emptyBody={t('Try removing a filter.','جرّب تشيل فلتر.')} emptyAction={t('Clear filters','مسح الفلاتر')}>
    {C.map(([n,d,r,x,b])=><ClinicCard key={n} name={n} distance={d} rating={r} next={x} nextLabel={t('Next:','أقرب موعد:')} badge={b} onClick={()=>go('clinic')}/>)}</ListState></div></Screen>}
function Clinic(){const {t,go}=useL();const [tab,setTab]=React.useState(0);
  const D=[[t('Dr. Mona Adel','د. منى عادل'),t('General vet','طبيب عام'),t('8 years','8 سنين')],[t('Dr. Omar Samy','د. عمر سامي'),t('Surgery','جراحة'),t('12 years','12 سنة')]];
  return <Screen header={<Header back="clinics" title="" right={<IconButton plain icon="heart" label={t('Save','حفظ')}/>} transparent/>}>
    <div style={{marginTop:-56,paddingBottom:90}}><Photo w="100%" h={190} r={0} label={t('cover photo','صورة الغلاف')}/>
    <div style={{padding:16,display:'flex',flexDirection:'column',gap:14}}><div><div className="t-h1">{t('Paws Vet Clinic','عيادة باوز البيطرية')}</div><div style={{display:'flex',gap:10,alignItems:'center',marginTop:4}}><Rating value={5} size={16}/><span dir="ltr">4.8</span><StatusBadge status="completed">{t('Open until 9 PM','مفتوح لحد 9 م')}</StatusBadge></div></div>
    <div style={{display:'flex',gap:8}}><Button size="m" variant="secondary" icon="phone" style={{flex:1}}>{t('Call','اتصال')}</Button><Button size="m" variant="secondary" icon="message-circle" style={{flex:1}}>WhatsApp</Button><Button size="m" variant="secondary" icon="navigation" style={{flex:1}}>{t('Directions','الاتجاهات')}</Button></div>
    <div style={{display:'flex',gap:8}}>{[t('About','نبذة'),t('Services','الخدمات'),t('Doctors','الأطباء'),t('Reviews','التقييمات')].map((x,i)=><Chip key={i} on={tab===i} onClick={()=>setTab(i)}>{x}</Chip>)}</div>
    {tab===2?D.map(([n,s,e])=><Card key={n} pad={12} onClick={()=>go('bservice')} style={{display:'flex',gap:12,alignItems:'center'}}><Photo r={32}/><div style={{flex:1}}><b>{n}</b><div className="t-cap">{s} · {e}</div></div><Icon name="chevron-right" flip size={18}/></Card>):<div style={{color:'var(--text-secondary)'}}>{t('Full-service small animal clinic in Maadi. Vaccinations, surgery, grooming and lab tests.','عيادة حيوانات أليفة متكاملة في المعادي. تطعيمات، جراحة، جروومنج وتحاليل.')}</div>}</div></div>
    <div style={{position:'absolute',bottom:0,insetInline:0,padding:'12px 16px 20px',background:'var(--surface)',borderTop:'1px solid var(--border)'}}><Button block onClick={()=>go('bservice')}>{t('Book now','احجز دلوقتي')}</Button></div></Screen>}
const steps=t=>[t('Service','الخدمة'),t('Doctor','الدكتور'),t('Time','الوقت'),t('Pet','الحيوان'),t('Summary','الملخص')];
function BHead({n,back,title}){const {t}=useL();return <><Header back={back} title={title}/><div style={{padding:'0 16px 8px'}}><Stepper steps={steps(t)} current={n}/></div></>}
function BService(){const {t,go,bk,setBk}=useL();
  const S=[[t('General check-up','كشف عام'),'30',250],[t('Vaccination','تطعيم'),'20',300],[t('Dental cleaning','تنضيف أسنان'),'45',600]];
  return <Screen header={<BHead n={0} back="clinic" title={t('Choose service','اختار الخدمة')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:10}}>
    <ListState emptyIcon="stethoscope" emptyTitle={t('No services for this species','مفيش خدمات للنوع ده')}>{S.map(([n,m,p])=><Card key={n} tint={bk.svc===n} onClick={()=>{setBk({...bk,svc:n,price:p});go('bdoctor')}} pad={14} style={{display:'flex',justifyContent:'space-between',alignItems:'center'}}><div><b>{n}</b><div className="t-cap">{ltr(m+' min')}</div></div><b dir="ltr">{p} EGP</b></Card>)}</ListState></div></Screen>}
function BDoctor(){const {t,go,bk,setBk}=useL();
  const D=[t('Any available doctor','أي دكتور متاح'),t('Dr. Mona Adel','د. منى عادل'),t('Dr. Omar Samy','د. عمر سامي')];
  return <Screen header={<BHead n={1} back="bservice" title={t('Choose doctor','اختار الدكتور')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:10}}>{D.map((n,i)=><Card key={n} tint={bk.doc===n} onClick={()=>{setBk({...bk,doc:n});go('btime')}} pad={12} style={{display:'flex',gap:12,alignItems:'center'}}><Photo r={28} w={56} h={56} label={i?'photo':''}/><b>{n}</b></Card>)}</div></Screen>}
function BTime(){const {t,go,bk,setBk,lang}=useL();
  const days=[['Sun','الأحد',19,true],['Mon','الاثنين',20,false],['Tue','الثلاثاء',21,false],['Wed','الأربع',22,false],['Thu','الخميس',23,false],['Fri','الجمعة',24,true],['Sat','السبت',25,false]];
  const [d,setD]=React.useState(2);const slots=[['09:30',0],['10:00',0],['10:30',1],['11:00',0],['11:30',0],['12:00',1],['13:00',0],['13:30',0],['14:00',0]];
  return <Screen header={<BHead n={2} back="bdoctor" title={t('Pick a time','اختار الميعاد')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:14}}>
    <div style={{display:'flex',gap:8,overflow:'auto'}}>{days.map(([e,a,n,c],i)=><button key={i} disabled={c} onClick={()=>setD(i)} style={{flex:'none',width:56,padding:'8px 0',borderRadius:12,border:'1.5px solid '+(d===i?'var(--primary)':'var(--border)'),background:d===i?'var(--primary)':'var(--surface)',color:d===i?'var(--on-primary)':'var(--text-primary)',opacity:c?.4:1,fontFamily:'inherit',cursor:c?'not-allowed':'pointer'}}><div className="t-cap" style={{color:'inherit'}}>{lang==='ar'?a:e}</div><b>{n}</b></button>)}</div>
    {d===0||d===5?<Banner tone="warning">{t('The clinic is closed on this day.','العيادة مقفولة اليوم ده.')}</Banner>:<div style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:8}}>{slots.map(([s,x])=><SlotChip key={s} time={s} disabled={!!x} on={bk.slot===s} onClick={()=>setBk({...bk,slot:s})}/>)}</div>}
    <div className="t-cap">{t('Times shown in Cairo time.','المواعيد بتوقيت القاهرة.')}</div>
    <Button block disabled={!bk.slot} onClick={()=>go('bdetails')}>{t('Continue','متابعة')}</Button></div></Screen>}
function BDetails(){const {t,go}=useL();const [p,setP]=React.useState(0);
  return <Screen header={<BHead n={3} back="btime" title={t('Pet and notes','الحيوان وملاحظات')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:12}}>{[t('Milo','ميلو'),t('Max','ماكس')].map((n,i)=><Card key={n} tint={p===i} onClick={()=>setP(i)} pad={12} style={{display:'flex',gap:12,alignItems:'center'}}><Photo r={26} w={52} h={52}/><b>{n}</b></Card>)}<Button variant="ghost" icon="plus">{t('Add a new pet','إضافة حيوان جديد')}</Button><Input label={t('Notes (optional)','ملاحظات (اختياري)')} placeholder={t('Anything the vet should know','أي حاجة الدكتور لازم يعرفها')}/><Button block onClick={()=>go('bsummary')}>{t('Continue','متابعة')}</Button></div></Screen>}
function BSummary(){const {t,go,bk,st}=useL();const [ld,setLd]=React.useState(false);const off=st==='error';
  const rows=[[t('Clinic','العيادة'),t('Paws Vet Clinic','عيادة باوز')],[t('Doctor','الدكتور'),bk.doc||t('Any available doctor','أي دكتور متاح')],[t('Service','الخدمة'),bk.svc||t('General check-up','كشف عام')],[t('When','الميعاد'),<span>{t('Tue 21 Oct','الثلاثاء 21 أكتوبر')} · {ltr(bk.slot||'10:30')}</span>],[t('Price','السعر'),<b dir="ltr">{bk.price||250} EGP</b>]];
  return <Screen header={<BHead n={4} back="bdetails" title={t('Summary','الملخص')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:12}}>
    {off&&<Banner tone="danger">{t('You are offline. Booking needs a connection.','إنت أوفلاين. الحجز محتاج إنترنت.')}</Banner>}
    <Card pad={0}>{rows.map(([a,b],i)=><div key={i} style={{display:'flex',justifyContent:'space-between',padding:14,borderTop:i?'1px solid var(--border)':0}}><span style={{color:'var(--text-secondary)'}}>{a}</span><span>{b}</span></div>)}</Card>
    <Card tint pad={14} style={{display:'flex',gap:12,alignItems:'center'}}><Icon name="banknote" style={{color:'var(--primary)'}}/><div style={{flex:1}}><b>{t('Pay at clinic','الدفع في العيادة')}</b></div><Icon name="circle-check" style={{color:'var(--primary)'}}/></Card>
    <div className="t-cap">{t('Free cancellation until 2 hours before. Policy to be confirmed.','إلغاء مجاني قبل الميعاد بساعتين. السياسة محتاجة تأكيد.')}</div>
    <Button block disabled={off} loading={ld} onClick={()=>{setLd(true);setTimeout(()=>{setLd(false);go('bsuccess')},900)}}>{t('Confirm booking','تأكيد الحجز')}</Button></div></Screen>}
function BSuccess(){const {t,go,bk}=useL();
  return <Screen><div style={{padding:'48px 24px',display:'flex',flexDirection:'column',alignItems:'center',gap:14,textAlign:'center'}}><div style={{width:96,height:96,borderRadius:'50%',background:'var(--success-bg)',color:'var(--success)',display:'flex',alignItems:'center',justifyContent:'center'}}><Icon name="check" size={52}/></div><div className="t-h1">{t('Booking confirmed','تم تأكيد الحجز')}</div><div style={{color:'var(--text-secondary)'}}>{t('Paws Vet Clinic','عيادة باوز')} · {t('Tue 21 Oct','الثلاثاء 21 أكتوبر')} · {ltr(bk.slot||'10:30')}</div><div style={{width:'100%',display:'flex',flexDirection:'column',gap:8,marginTop:16}}><Button block onClick={()=>go('booking')}>{t('View booking','عرض الحجز')}</Button><Button variant="secondary" block onClick={()=>go('home')}>{t('Back to home','الرجوع للرئيسية')}</Button></div></div></Screen>}
function Bookings(){const {t,go}=useL();const [tab,setTab]=React.useState(0);
  return <Screen tab="bookings" header={<Header title={t('My bookings','حجوزاتي')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:12}}><div style={{display:'flex',gap:8}}>{[t('Upcoming','الجاية'),t('Past','السابقة'),t('Cancelled','الملغية')].map((x,i)=><Chip key={i} on={tab===i} onClick={()=>setTab(i)}>{x}</Chip>)}</div>
    <ListState emptyIcon="calendar-x" emptyTitle={t('No bookings yet','مفيش حجوزات لسه')} emptyAction={t('Find a clinic','دوّر على عيادة')} onAction={()=>go('clinics')}>
    {[[t('Paws Vet Clinic','عيادة باوز'),t('Tue 21 Oct','الثلاثاء 21 أكتوبر'),'10:30','confirmed',t('Confirmed','مؤكد')],[t('Happy Tails','هابي تيلز'),t('Sun 4 Oct','الأحد 4 أكتوبر'),'12:00','completed',t('Completed','تمت')],[t('Happy Tails','هابي تيلز'),t('Mon 21 Sep','الاثنين 21 سبتمبر'),'09:00','cancelled',t('Cancelled','ملغي')]].slice(tab===0?0:tab,tab===0?1:tab+1).map(([c,d,x,s,l])=><Card key={c+d} onClick={()=>go(tab===1?'review':'booking')} style={{display:'flex',flexDirection:'column',gap:6}}><div style={{display:'flex',justifyContent:'space-between'}}><b>{c}</b><StatusBadge status={s}>{l}</StatusBadge></div><div className="t-cap">{d} · {ltr(x)} · {t('Milo','ميلو')}</div></Card>)}</ListState></div></Screen>}
function Booking(){const {t,go}=useL();const [ci,setCi]=React.useState(false);const [cx,setCx]=React.useState(false);
  return <Screen header={<Header back="bookings" title={t('Booking details','تفاصيل الحجز')}/>} sheet={cx&&<ConfirmSheet title={t('Cancel this booking?','تلغي الحجز؟')} body={t('Pick a reason so the clinic can improve.','اختار السبب عشان العيادة تتحسّن.')} confirm={t('Cancel booking','إلغاء الحجز')} cancel={t('Keep booking','خلّي الحجز')} onCancel={()=>setCx(false)} onConfirm={()=>{setCx(false);go('bookings')}}><div style={{display:'flex',gap:8,flexWrap:'wrap'}}>{[t('Schedule conflict','مشغول'),t('Pet recovered','الحيوان اتحسّن'),t('Other','تاني')].map(x=><Chip key={x}>{x}</Chip>)}</div></ConfirmSheet>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:14}}>
    <Stepper steps={[t('Confirmed','مؤكد'),t('Checked in','وصلت'),t('In progress','جاري'),t('Done','تم')]} current={ci?1:0}/>
    {ci?<Card tint pad={18} style={{textAlign:'center'}}><div className="t-cap">{t('Your number','رقمك')}</div><div style={{fontSize:56,fontWeight:700,color:'var(--primary)',lineHeight:1.1}} dir="ltr">A-14</div><div style={{display:'flex',justifyContent:'space-around',marginTop:12}}>{[[t('Now serving','دلوقتي'),'A-11'],[t('Ahead of you','قدامك'),'2'],[t('Est. wait','الانتظار'),'~15 '+t('min','د')]].map(([a,b])=><div key={a}><div className="t-cap">{a}</div><b dir="ltr">{b}</b></div>)}</div></Card>
    :<Card style={{display:'flex',flexDirection:'column',alignItems:'center',gap:10}}><div className="fe-ph" style={{width:150,height:150,borderRadius:12}}>QR check-in</div><div className="t-cap">{t('Show this code at the reception','وري الكود ده للاستقبال')}</div><Button size="s" variant="outline" onClick={()=>setCi(true)}>{t('Demo: simulate check-in','تجربة: تسجيل الوصول')}</Button></Card>}
    <Card pad={14}><b>{t('Paws Vet Clinic','عيادة باوز')}</b><div className="t-cap">{t('Dr. Mona Adel · General check-up','د. منى عادل · كشف عام')}<br/>{t('Tue 21 Oct','الثلاثاء 21 أكتوبر')} · {ltr('10:30')}</div></Card>
    <div style={{display:'flex',gap:8}}><Button variant="secondary" size="m" icon="phone" style={{flex:1}}>{t('Call','اتصال')}</Button><Button variant="secondary" size="m" icon="navigation" style={{flex:1}}>{t('Directions','الاتجاهات')}</Button></div>
    <Button variant="outline" block icon="calendar-clock">{t('Reschedule','تغيير الميعاد')}</Button><Button variant="ghost" block style={{color:'var(--danger)'}} onClick={()=>setCx(true)}>{t('Cancel booking','إلغاء الحجز')}</Button></div></Screen>}
function Review(){const {t,go}=useL();const [r,setR]=React.useState(4);
  return <Screen header={<Header back="bookings" title={t('Rate your visit','قيّم زيارتك')}/>}><div style={{padding:24,display:'flex',flexDirection:'column',alignItems:'center',gap:16,textAlign:'center'}}><Photo w={80} h={80} r={40} label="logo"/><div className="t-h2">{t('How was Happy Tails?','إيه رأيك في هابي تيلز؟')}</div><Rating value={r} size={40} onChange={setR}/><div style={{width:'100%'}}><Input placeholder={t('Add a comment (optional)','أضف تعليق (اختياري)')}/></div><Button block onClick={()=>go('bookings')}>{t('Submit','إرسال')}</Button></div></Screen>}
function Emergency(){const {t,go}=useL();
  return <Screen header={<Header back="home" title={t('Emergency','الطوارئ')}/>}><div style={{padding:16,display:'flex',flexDirection:'column',gap:12}}><Banner tone="danger">{t('Emergency vets near you','أقرب دكاترة طوارئ ليك')}</Banner><Banner tone="info">{t('Location is off. Showing clinics in Cairo.','الموقع مقفول. بنعرض عيادات القاهرة.')}</Banner>
    <ListState emptyIcon="siren" emptyTitle={t('No emergency clinics found','مفيش عيادات طوارئ')}>{[[t('Nile 24h Pet Hospital','مستشفى النيل 24 ساعة'),'4.1 km'],[t('Vet Rescue Maadi','فيت ريسكيو المعادي'),'5.3 km']].map(([n,d])=><Card key={n} style={{display:'flex',flexDirection:'column',gap:10}}><div style={{display:'flex',justifyContent:'space-between'}}><b>{n}</b><span dir="ltr" className="t-cap">{d}</span></div><div style={{display:'flex',gap:8}}><Button variant="destructive" icon="phone" style={{flex:1}}>{t('Call','اتصال')}</Button><Button variant="secondary" icon="navigation" style={{flex:1}}>{t('Directions','الاتجاهات')}</Button></div></Card>)}</ListState></div></Screen>}
Object.assign(window,{Clinics,Clinic,BService,BDoctor,BTime,BDetails,BSummary,BSuccess,Bookings,Booking,Review,Emergency});
})();