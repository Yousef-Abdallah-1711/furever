{
  "name": "furever",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "i18n:check": "tsx packages/i18n/scripts/check-parity.ts",
    "tokens:build": "tsx packages/design-tokens/scripts/build.ts",
    "types:gen": "tsx packages/shared/scripts/gen-types.ts",
    "db:test": "pnpm --filter backend exec supabase test db",
    "db:policy-coverage": "tsx backend/supabase/scripts/check-policy-coverage.ts",
    "stack:up": "powershell -ExecutionPolicy Bypass -File scripts/stack-up.ps1",
    "stack:down": "powershell -ExecutionPolicy Bypass -File scripts/stack-down.ps1",
    "stack:reset": "powershell -ExecutionPolicy Bypass -File scripts/stack-reset.ps1",
    "build:prod-web": "powershell -ExecutionPolicy Bypass -File scripts/build-prod-web.ps1",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "26.6.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tsx": "4.23.15",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
